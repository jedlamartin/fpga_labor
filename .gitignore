# ==========================================
# Microchip Libero SoC (FPGA Hardware)
# ==========================================
# We are tracking .prjx, /component/, and /smartgen/ in this workflow!
*.bak
*.log
*.log.bak*
*.jou
*.msg

# Ignore massive generated hardware build folders
/fpga_labor/designer/
/fpga_labor/synthesis/
/fpga_labor/simulation/
/fpga_labor/tooldata/
/fpga_labor/viewdraw/
/fpga_labor/syndist/
/fpga_labor/identify_idc/

# Ignore constraints layout logs
/fpga_labor/constraint/*.log
/fpga_labor/constraint/*.def

# ==========================================
# SoftConsole / Eclipse (RISC-V Firmware)
# ==========================================
# Ignore Eclipse workspace metadata
.metadata/
.safetable/
.root/

# Ignore compiled C/C++ firmware outputs
**/Debug-*/
**/Release-*/
**/LIM-*/
*.elf
*.hex
*.map
*.lst
*.o
*.d
*.bin

# ==========================================
# SmartHLS (C++ to RTL)
# ==========================================
# Ignore LLVM intermediates and HLS synthesis logs
hls_output/
reports/
syntmp/
dot_graphs/
*.bc
*.sw_binary
*.ll

# ==========================================
# OS Generated Files
# ==========================================
Thumbs.db
.DS_Store