  45:../src/middleware/bacnet/src/bacdcode.c **** /** @file bacdcode.c  Functions to encode/decode BACnet data types */
  46:../src/middleware/bacnet/src/bacdcode.c **** 
  47:../src/middleware/bacnet/src/bacdcode.c **** 
  48:../src/middleware/bacnet/src/bacdcode.c **** /* max-segments-accepted
  49:../src/middleware/bacnet/src/bacdcode.c ****    B'000'      Unspecified number of segments accepted.
  50:../src/middleware/bacnet/src/bacdcode.c ****    B'001'      2 segments accepted.
  51:../src/middleware/bacnet/src/bacdcode.c ****    B'010'      4 segments accepted.
  52:../src/middleware/bacnet/src/bacdcode.c ****    B'011'      8 segments accepted.
  53:../src/middleware/bacnet/src/bacdcode.c ****    B'100'      16 segments accepted.
  54:../src/middleware/bacnet/src/bacdcode.c ****    B'101'      32 segments accepted.
  55:../src/middleware/bacnet/src/bacdcode.c ****    B'110'      64 segments accepted.
  56:../src/middleware/bacnet/src/bacdcode.c ****    B'111'      Greater than 64 segments accepted.
  57:../src/middleware/bacnet/src/bacdcode.c **** */
  58:../src/middleware/bacnet/src/bacdcode.c **** 
  59:../src/middleware/bacnet/src/bacdcode.c **** /* max-APDU-length-accepted
  60:../src/middleware/bacnet/src/bacdcode.c ****    B'0000'  Up to MinimumMessageSize (50 octets)
  61:../src/middleware/bacnet/src/bacdcode.c ****    B'0001'  Up to 128 octets
  62:../src/middleware/bacnet/src/bacdcode.c ****    B'0010'  Up to 206 octets (fits in a LonTalk frame)
  63:../src/middleware/bacnet/src/bacdcode.c ****    B'0011'  Up to 480 octets (fits in an ARCNET frame)
  64:../src/middleware/bacnet/src/bacdcode.c ****    B'0100'  Up to 1024 octets
  65:../src/middleware/bacnet/src/bacdcode.c ****    B'0101'  Up to 1476 octets (fits in an ISO 8802-3 frame)
  66:../src/middleware/bacnet/src/bacdcode.c ****    B'0110'  reserved by ASHRAE
  67:../src/middleware/bacnet/src/bacdcode.c ****    B'0111'  reserved by ASHRAE
  68:../src/middleware/bacnet/src/bacdcode.c ****    B'1000'  reserved by ASHRAE
  69:../src/middleware/bacnet/src/bacdcode.c ****    B'1001'  reserved by ASHRAE
  70:../src/middleware/bacnet/src/bacdcode.c ****    B'1010'  reserved by ASHRAE
  71:../src/middleware/bacnet/src/bacdcode.c ****    B'1011'  reserved by ASHRAE
  72:../src/middleware/bacnet/src/bacdcode.c ****    B'1100'  reserved by ASHRAE
  73:../src/middleware/bacnet/src/bacdcode.c ****    B'1101'  reserved by ASHRAE
  74:../src/middleware/bacnet/src/bacdcode.c ****    B'1110'  reserved by ASHRAE
  75:../src/middleware/bacnet/src/bacdcode.c ****    B'1111'  reserved by ASHRAE
  76:../src/middleware/bacnet/src/bacdcode.c **** */
  77:../src/middleware/bacnet/src/bacdcode.c **** 
  78:../src/middleware/bacnet/src/bacdcode.c **** /* Encoding of BACNET Length/Value/Type tag
  79:../src/middleware/bacnet/src/bacdcode.c ****    From clause 20.2.1.3.1
  80:../src/middleware/bacnet/src/bacdcode.c **** 
  81:../src/middleware/bacnet/src/bacdcode.c ****    B'000'   interpreted as Value  = FALSE if application class == BOOLEAN
  82:../src/middleware/bacnet/src/bacdcode.c ****    B'001'   interpreted as Value  = TRUE  if application class == BOOLEAN
  83:../src/middleware/bacnet/src/bacdcode.c **** 
  84:../src/middleware/bacnet/src/bacdcode.c ****    B'000'   interpreted as Length = 0     if application class != BOOLEAN
  85:../src/middleware/bacnet/src/bacdcode.c ****    B'001'   interpreted as Length = 1
  86:../src/middleware/bacnet/src/bacdcode.c ****    B'010'   interpreted as Length = 2
  87:../src/middleware/bacnet/src/bacdcode.c ****    B'011'   interpreted as Length = 3
  88:../src/middleware/bacnet/src/bacdcode.c ****    B'100'   interpreted as Length = 4
  89:../src/middleware/bacnet/src/bacdcode.c ****    B'101'   interpreted as Length > 4
  90:../src/middleware/bacnet/src/bacdcode.c ****    B'110'   interpreted as Type   = Opening Tag
  91:../src/middleware/bacnet/src/bacdcode.c ****    B'111'   interpreted as Type   = Closing Tag
  92:../src/middleware/bacnet/src/bacdcode.c **** */
  93:../src/middleware/bacnet/src/bacdcode.c **** 
  94:../src/middleware/bacnet/src/bacdcode.c **** 
