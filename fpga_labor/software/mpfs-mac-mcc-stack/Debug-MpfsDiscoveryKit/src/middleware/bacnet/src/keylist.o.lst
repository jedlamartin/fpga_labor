  35:../src/middleware/bacnet/src/keylist.c **** /* */
  36:../src/middleware/bacnet/src/keylist.c **** /* This is an enhanced array of pointers to data. */
  37:../src/middleware/bacnet/src/keylist.c **** /* The list is sorted, indexed, and keyed. */
  38:../src/middleware/bacnet/src/keylist.c **** /* The array is much faster than a linked list. */
  39:../src/middleware/bacnet/src/keylist.c **** /* It stores a pointer to data, which you must */
  40:../src/middleware/bacnet/src/keylist.c **** /* malloc and free on your own, or just use */
  41:../src/middleware/bacnet/src/keylist.c **** /* static data */
  42:../src/middleware/bacnet/src/keylist.c **** 
