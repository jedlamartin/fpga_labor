  67:../src/middleware/bacnet/src/npdu.c **** /*
  68:../src/middleware/bacnet/src/npdu.c **** 
  69:../src/middleware/bacnet/src/npdu.c **** The following ICI parameters are exchanged with the
  70:../src/middleware/bacnet/src/npdu.c **** various service primitives across an API:
  71:../src/middleware/bacnet/src/npdu.c **** 
  72:../src/middleware/bacnet/src/npdu.c **** 'destination_address' (DA): the address of the device(s)
  73:../src/middleware/bacnet/src/npdu.c **** intended to receive the service primitive. Its format (device name,
  74:../src/middleware/bacnet/src/npdu.c **** network address, etc.) is a local matter. This address
  75:../src/middleware/bacnet/src/npdu.c **** may also be a multicast, local broadcast or global broadcast type.
  76:../src/middleware/bacnet/src/npdu.c **** 
  77:../src/middleware/bacnet/src/npdu.c **** 'source_address' (SA): the address of the device from which
  78:../src/middleware/bacnet/src/npdu.c **** the service primitive was received. Its format (device name,
  79:../src/middleware/bacnet/src/npdu.c **** network address, etc.) is a local matter.
  80:../src/middleware/bacnet/src/npdu.c **** 
  81:../src/middleware/bacnet/src/npdu.c **** 'network_priority' (NP): a four-level network priority parameter
  82:../src/middleware/bacnet/src/npdu.c **** described in 6.2.2.
  83:../src/middleware/bacnet/src/npdu.c **** 
  84:../src/middleware/bacnet/src/npdu.c **** 'data_expecting_reply' (DER): a Boolean parameter that indicates
  85:../src/middleware/bacnet/src/npdu.c **** whether (TRUE) or not (FALSE) a reply service primitive
  86:../src/middleware/bacnet/src/npdu.c **** is expected for the service being issued.
  87:../src/middleware/bacnet/src/npdu.c **** 
  88:../src/middleware/bacnet/src/npdu.c **** 
  89:../src/middleware/bacnet/src/npdu.c **** Table 5-1. Applicability of ICI parameters for abstract service primitives
  90:../src/middleware/bacnet/src/npdu.c ****      Service Primitive         DA           SA         NP        DER
  91:../src/middleware/bacnet/src/npdu.c **** CONF_SERV.request              Yes          No         Yes       Yes
  92:../src/middleware/bacnet/src/npdu.c **** CONF_SERV.indication           Yes         Yes         Yes       Yes
  93:../src/middleware/bacnet/src/npdu.c **** CONF_SERV.response             Yes          No         Yes       Yes
  94:../src/middleware/bacnet/src/npdu.c **** CONF_SERV.confirm              Yes         Yes         Yes        No
  95:../src/middleware/bacnet/src/npdu.c **** UNCONF_SERV.request            Yes          No         Yes        No
  96:../src/middleware/bacnet/src/npdu.c **** UNCONF_SERV.indication         Yes         Yes         Yes        No
  97:../src/middleware/bacnet/src/npdu.c **** REJECT.request                 Yes          No         Yes        No
  98:../src/middleware/bacnet/src/npdu.c **** REJECT.indication              Yes         Yes         Yes        No
  99:../src/middleware/bacnet/src/npdu.c **** SEGMENT_ACK.request            Yes          No         Yes        No
 100:../src/middleware/bacnet/src/npdu.c **** SEGMENT_ACK.indication         Yes         Yes         Yes        No
 101:../src/middleware/bacnet/src/npdu.c **** ABORT.request                  Yes          No         Yes        No
 102:../src/middleware/bacnet/src/npdu.c **** ABORT.indication               Yes         Yes         Yes        No
 103:../src/middleware/bacnet/src/npdu.c **** */
 104:../src/middleware/bacnet/src/npdu.c **** 
 105:../src/middleware/bacnet/src/npdu.c **** 
 106:../src/middleware/bacnet/src/npdu.c **** /** Encode the NPDU portion of a message to be sent, based on the npdu_data
 107:../src/middleware/bacnet/src/npdu.c ****  *  and associated data.
 108:../src/middleware/bacnet/src/npdu.c ****  *  If this is to be a Network Layer Control Message, there are probably
 109:../src/middleware/bacnet/src/npdu.c ****  *  more bytes which will need to be encoded following the ones encoded here.
 110:../src/middleware/bacnet/src/npdu.c ****  *  The Network Layer Protocol Control Information byte is described
 111:../src/middleware/bacnet/src/npdu.c ****  *  in section 6.2.2 of the BACnet standard.
 112:../src/middleware/bacnet/src/npdu.c ****  * @param npdu [out] Buffer which will hold the encoded NPDU header bytes.
 113:../src/middleware/bacnet/src/npdu.c ****  * 					 The size isn't given, but it must be at least 2 bytes
 114:../src/middleware/bacnet/src/npdu.c ****  *                   for the simplest case, and should always be at least 24
 115:../src/middleware/bacnet/src/npdu.c ****  *                   bytes to accommodate the maximal case (all fields loaded).
 116:../src/middleware/bacnet/src/npdu.c ****  * @param dest [in] The routing destination information if the message must
 117:../src/middleware/bacnet/src/npdu.c ****  *                   be routed to reach its destination.
 118:../src/middleware/bacnet/src/npdu.c ****  *                   If dest->net and dest->len are 0, there is no
 119:../src/middleware/bacnet/src/npdu.c ****  *                   routing destination information.
 120:../src/middleware/bacnet/src/npdu.c ****  * @param src  [in] The routing source information if the message was routed
 121:../src/middleware/bacnet/src/npdu.c ****  *                   from another BACnet network.
 122:../src/middleware/bacnet/src/npdu.c ****  *                   If src->net and src->len are 0, there is no
 123:../src/middleware/bacnet/src/npdu.c ****  *                   routing source information.
 124:../src/middleware/bacnet/src/npdu.c ****  *                   This src describes the original source of the message when
 125:../src/middleware/bacnet/src/npdu.c ****  *                   it had to be routed to reach this BACnet Device.
 126:../src/middleware/bacnet/src/npdu.c ****  * @param npdu_data [in] The structure which describes how the NCPI and other
 127:../src/middleware/bacnet/src/npdu.c ****  *                   NPDU bytes should be encoded.
 128:../src/middleware/bacnet/src/npdu.c ****  * @return On success, returns the number of bytes which were encoded into the
 129:../src/middleware/bacnet/src/npdu.c ****  * 		   NPDU section.
 130:../src/middleware/bacnet/src/npdu.c ****  *         If 0 or negative, there were problems with the data or encoding.
 131:../src/middleware/bacnet/src/npdu.c ****  */
 132:../src/middleware/bacnet/src/npdu.c **** int npdu_encode_pdu(
 133:../src/middleware/bacnet/src/npdu.c ****     uint8_t * npdu,
 134:../src/middleware/bacnet/src/npdu.c ****     BACNET_ADDRESS * dest,
