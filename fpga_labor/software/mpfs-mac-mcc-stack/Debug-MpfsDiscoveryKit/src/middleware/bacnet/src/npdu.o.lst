 227:../src/middleware/bacnet/src/npdu.c **** 
 228:../src/middleware/bacnet/src/npdu.c **** /* Configure the NPDU portion of the packet for an APDU */
 229:../src/middleware/bacnet/src/npdu.c **** /* This function does not handle the network messages, just APDUs. */
 230:../src/middleware/bacnet/src/npdu.c **** /* From BACnet 5.1:
 231:../src/middleware/bacnet/src/npdu.c **** Applicability of ICI parameters for abstract service primitives
 232:../src/middleware/bacnet/src/npdu.c **** Service Primitive      DA  SA  NP  DER
 233:../src/middleware/bacnet/src/npdu.c **** -----------------      --- --- --- ---
 234:../src/middleware/bacnet/src/npdu.c **** CONF_SERV.request      Yes No  Yes Yes
 235:../src/middleware/bacnet/src/npdu.c **** CONF_SERV.indication   Yes Yes Yes Yes
 236:../src/middleware/bacnet/src/npdu.c **** CONF_SERV.response     Yes No  Yes Yes
 237:../src/middleware/bacnet/src/npdu.c **** CONF_SERV.confirm      Yes Yes Yes No
 238:../src/middleware/bacnet/src/npdu.c **** UNCONF_SERV.request    Yes No  Yes No
 239:../src/middleware/bacnet/src/npdu.c **** UNCONF_SERV.indication Yes Yes Yes No
 240:../src/middleware/bacnet/src/npdu.c **** REJECT.request         Yes No  Yes No
