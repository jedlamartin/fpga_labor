  44:../src/middleware/bacnet/src/datetime.c **** 
  45:../src/middleware/bacnet/src/datetime.c **** /* define our epic beginnings */
  46:../src/middleware/bacnet/src/datetime.c **** #define BACNET_EPOCH_YEAR 1900
  47:../src/middleware/bacnet/src/datetime.c **** /* 1/1/1900 is a Monday */
