  49:../src/middleware/bacnet/src/datetime.c **** 
  50:../src/middleware/bacnet/src/datetime.c **** /* BACnet Date */
  51:../src/middleware/bacnet/src/datetime.c **** /* year = years since 1900 */
  52:../src/middleware/bacnet/src/datetime.c **** /* month 1=Jan */
  53:../src/middleware/bacnet/src/datetime.c **** /* day = day of month 1..31 */
  54:../src/middleware/bacnet/src/datetime.c **** /* wday 1=Monday...7=Sunday */
  55:../src/middleware/bacnet/src/datetime.c **** 
  56:../src/middleware/bacnet/src/datetime.c **** /* Wildcards:
  57:../src/middleware/bacnet/src/datetime.c ****   A value of X'FF' in any of the four octets
  58:../src/middleware/bacnet/src/datetime.c ****   shall indicate that the value is unspecified.
  59:../src/middleware/bacnet/src/datetime.c ****   If all four octets = X'FF', the corresponding
  60:../src/middleware/bacnet/src/datetime.c ****   time or date may be interpreted as "any" or "don't care"
  61:../src/middleware/bacnet/src/datetime.c **** */
