  78:../src/middleware/bacnet/demo/handler/h_dcc.c **** /** Handler for a Device Communication Control (DCC) request.
  79:../src/middleware/bacnet/demo/handler/h_dcc.c ****  * @ingroup DMDCC
  80:../src/middleware/bacnet/demo/handler/h_dcc.c ****  * This handler will be invoked by apdu_handler() if it has been enabled
  81:../src/middleware/bacnet/demo/handler/h_dcc.c ****  * by a call to apdu_set_confirmed_handler().
  82:../src/middleware/bacnet/demo/handler/h_dcc.c ****  * This handler builds a response packet, which is
  83:../src/middleware/bacnet/demo/handler/h_dcc.c ****  * - an Abort if
  84:../src/middleware/bacnet/demo/handler/h_dcc.c ****  *   - the message is segmented
  85:../src/middleware/bacnet/demo/handler/h_dcc.c ****  *   - if decoding fails
  86:../src/middleware/bacnet/demo/handler/h_dcc.c ****  *   - if not a known DCC state
  87:../src/middleware/bacnet/demo/handler/h_dcc.c ****  * - an Error if the DCC password is incorrect
  88:../src/middleware/bacnet/demo/handler/h_dcc.c ****  * - else tries to send a simple ACK for the DCC on success,
  89:../src/middleware/bacnet/demo/handler/h_dcc.c ****  *   and sets the DCC state requested.
  90:../src/middleware/bacnet/demo/handler/h_dcc.c ****  *
  91:../src/middleware/bacnet/demo/handler/h_dcc.c ****  * @param service_request [in] The contents of the service request.
  92:../src/middleware/bacnet/demo/handler/h_dcc.c ****  * @param service_len [in] The length of the service_request.
  93:../src/middleware/bacnet/demo/handler/h_dcc.c ****  * @param src [in] BACNET_ADDRESS of the source of the message
  94:../src/middleware/bacnet/demo/handler/h_dcc.c ****  * @param service_data [in] The BACNET_CONFIRMED_SERVICE_DATA information
  95:../src/middleware/bacnet/demo/handler/h_dcc.c ****  *                          decoded from the APDU header of this message.
  96:../src/middleware/bacnet/demo/handler/h_dcc.c ****  */
  97:../src/middleware/bacnet/demo/handler/h_dcc.c **** void handler_device_communication_control(
  98:../src/middleware/bacnet/demo/handler/h_dcc.c ****     uint8_t * service_request,
