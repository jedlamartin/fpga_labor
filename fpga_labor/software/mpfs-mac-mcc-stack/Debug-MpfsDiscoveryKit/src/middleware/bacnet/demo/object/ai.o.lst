 960:../src/middleware/bacnet/demo/object/ai.c ****                 CurrentAI->Remaining_Time_Delay = CurrentAI->Time_Delay;
 961:../src/middleware/bacnet/demo/object/ai.c ****                 break;
 962:../src/middleware/bacnet/demo/object/ai.c **** 
 963:../src/middleware/bacnet/demo/object/ai.c ****             case EVENT_STATE_HIGH_LIMIT:
 964:../src/middleware/bacnet/demo/object/ai.c ****                 /* Once exceeded, the Present_Value must fall below the High_Limit minus
 965:../src/middleware/bacnet/demo/object/ai.c ****                    the Deadband before a TO-NORMAL event is generated under these conditions:
