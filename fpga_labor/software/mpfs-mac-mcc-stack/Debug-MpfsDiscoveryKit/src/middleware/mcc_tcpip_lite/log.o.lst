  59:../src/middleware/mcc_tcpip_lite/log.c **** #define	LOG_PRIMASK	0x07	/* mask to extract priority part (internal) */
  60:../src/middleware/mcc_tcpip_lite/log.c **** /* extract priority */
  61:../src/middleware/mcc_tcpip_lite/log.c **** #define	LOG_PRI(p)	((p) & LOG_PRIMASK)
  62:../src/middleware/mcc_tcpip_lite/log.c **** #define LOG_NFACILITIES 24      /* current number of facilities */
  63:../src/middleware/mcc_tcpip_lite/log.c ****  #define LOG_FACMASK    0x03f8  /* mask to extract facility part */
  64:../src/middleware/mcc_tcpip_lite/log.c **** /* facility of pri */
  65:../src/middleware/mcc_tcpip_lite/log.c **** #define LOG_FAC(p)              (((p) & LOG_FACMASK) >> 3)	/* facility of pri */
  66:../src/middleware/mcc_tcpip_lite/log.c **** #define	LOG_MAKEPRI(fac, pri)	(((fac) << 3) | (pri))
  67:../src/middleware/mcc_tcpip_lite/log.c **** 
  68:../src/middleware/mcc_tcpip_lite/log.c **** /*arguments to setlogmask */
  69:../src/middleware/mcc_tcpip_lite/log.c **** #define	LOG_MASK(pri)	(1 << (pri))            /* mask for one priority */
  70:../src/middleware/mcc_tcpip_lite/log.c **** #define	LOG_UPTO(pri)	((1 << ((pri)+1)) - 1)	/* all priorities through pri */
  71:../src/middleware/mcc_tcpip_lite/log.c **** #define LOG_NILVALUE "-"
  72:../src/middleware/mcc_tcpip_lite/log.c **** 
