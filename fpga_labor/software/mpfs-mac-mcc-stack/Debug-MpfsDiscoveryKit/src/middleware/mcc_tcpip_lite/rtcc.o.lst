  31:../src/middleware/mcc_tcpip_lite/rtcc.c **** 
  32:../src/middleware/mcc_tcpip_lite/rtcc.c **** volatile uint16_t seconds_counter;
  33:../src/middleware/mcc_tcpip_lite/rtcc.c **** /******************************************************************************
  34:../src/middleware/mcc_tcpip_lite/rtcc.c **** 
  35:../src/middleware/mcc_tcpip_lite/rtcc.c ****   Summary:
  36:../src/middleware/mcc_tcpip_lite/rtcc.c ****     Initialize the clock calendar driver.
  37:../src/middleware/mcc_tcpip_lite/rtcc.c **** 
  38:../src/middleware/mcc_tcpip_lite/rtcc.c ****   Description:
  39:../src/middleware/mcc_tcpip_lite/rtcc.c ****     This function configured the basics of a software driven RTCC peripheral.
  40:../src/middleware/mcc_tcpip_lite/rtcc.c ****     It relies upon a periodic TMR1 event to provide time keeping.
  41:../src/middleware/mcc_tcpip_lite/rtcc.c ****     The Timer 1 clock provides a steady 100kHz time base.
  42:../src/middleware/mcc_tcpip_lite/rtcc.c ****     0x8000 counts in the TMR1 register will provide a 1HZ tick.
  43:../src/middleware/mcc_tcpip_lite/rtcc.c ****     CLOCKS_PER_SEC is configured for 1 and all is well.
  44:../src/middleware/mcc_tcpip_lite/rtcc.c ****  
  45:../src/middleware/mcc_tcpip_lite/rtcc.c ****   Precondition:
  46:../src/middleware/mcc_tcpip_lite/rtcc.c ****     None
  47:../src/middleware/mcc_tcpip_lite/rtcc.c **** 
  48:../src/middleware/mcc_tcpip_lite/rtcc.c ****   Parameters:
  49:../src/middleware/mcc_tcpip_lite/rtcc.c ****     None
  50:../src/middleware/mcc_tcpip_lite/rtcc.c **** 
  51:../src/middleware/mcc_tcpip_lite/rtcc.c ****   Returns:
  52:../src/middleware/mcc_tcpip_lite/rtcc.c ****     None
  53:../src/middleware/mcc_tcpip_lite/rtcc.c **** 
  54:../src/middleware/mcc_tcpip_lite/rtcc.c ****   Remarks:
  55:../src/middleware/mcc_tcpip_lite/rtcc.c ****     The C stdlib functions understand UNIX time but they need a UNIX time counter.
  56:../src/middleware/mcc_tcpip_lite/rtcc.c ****     UNIX time is the number of seconds elapsed since Midnight Jan 1, 1970
  57:../src/middleware/mcc_tcpip_lite/rtcc.c ****   ***************************************************************************/
