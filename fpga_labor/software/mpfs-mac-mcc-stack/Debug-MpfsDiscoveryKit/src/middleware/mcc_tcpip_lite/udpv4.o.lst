  96:../src/middleware/mcc_tcpip_lite/udpv4.c ****     /*
  97:../src/middleware/mcc_tcpip_lite/udpv4.c ****      * Add the UDP header checksum
  98:../src/middleware/mcc_tcpip_lite/udpv4.c ****      *
  99:../src/middleware/mcc_tcpip_lite/udpv4.c ****      * We take into account the TCP Pseudo header which consists of source address,
 100:../src/middleware/mcc_tcpip_lite/udpv4.c ****      * destination address, 1 byte of 0, 1 byte with the protocol number and the
 101:../src/middleware/mcc_tcpip_lite/udpv4.c ****      * overall packet length by relying on the fact that the 16 bit checksum field
 102:../src/middleware/mcc_tcpip_lite/udpv4.c ****      * and the 16 bit length field currently are 0. We add the length and protocol
 103:../src/middleware/mcc_tcpip_lite/udpv4.c ****      * number and use these as the initial seed value for the checksum calculation
 104:../src/middleware/mcc_tcpip_lite/udpv4.c ****      * and then set the payload checksum area to start at the source address in the
 105:../src/middleware/mcc_tcpip_lite/udpv4.c ****      * IPv4 header 8 bytes before the UDP header and increase the size to checksum
 106:../src/middleware/mcc_tcpip_lite/udpv4.c ****      * by 8... This works when we don't have any IP header options to transmit.
 107:../src/middleware/mcc_tcpip_lite/udpv4.c ****      */
 108:../src/middleware/mcc_tcpip_lite/udpv4.c ****     cksm = (uint16_t)(udpLength + UDP_TCPIP); /* Add in length and protocol component */
