 719:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 720:../src/middleware/ftp-client/FTP_CLIENT.c **** /* START FUNCTION DESCRIPTION ********************************************
 721:../src/middleware/ftp-client/FTP_CLIENT.c **** ftp_data_handler                   <FTP_CLIENT.LIB>
 722:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 723:../src/middleware/ftp-client/FTP_CLIENT.c **** SYNTAX: void ftp_data_handler(int (*dhnd)(), void * dhnd_data, word opts)
 724:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 725:../src/middleware/ftp-client/FTP_CLIENT.c **** KEYWORDS:       tcpip, ftp
 726:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 727:../src/middleware/ftp-client/FTP_CLIENT.c **** DESCRIPTION:    Sets a data handler for further FTP data transfer(s).
 728:../src/middleware/ftp-client/FTP_CLIENT.c ****                This handler is only used if the "buffer" parameter to
 729:../src/middleware/ftp-client/FTP_CLIENT.c ****                ftp_client_setup() is passed as NULL.
 730:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 731:../src/middleware/ftp-client/FTP_CLIENT.c ****                The handler is a function which must be coded according
 732:../src/middleware/ftp-client/FTP_CLIENT.c ****                the the following prototype:
 733:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 734:../src/middleware/ftp-client/FTP_CLIENT.c ****                  int my_handler(char * data, int len, longword offset,
 735:../src/middleware/ftp-client/FTP_CLIENT.c ****                                 int flags, void * dhnd_data);
 736:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 737:../src/middleware/ftp-client/FTP_CLIENT.c ****                This function is called with "data" pointing to a data
 738:../src/middleware/ftp-client/FTP_CLIENT.c ****                buffer, and "len" containing the length of that buffer.
 739:../src/middleware/ftp-client/FTP_CLIENT.c ****                "offset" is the byte number relative to the first byte
 740:../src/middleware/ftp-client/FTP_CLIENT.c ****                of the entire FTP stream.  This is useful for data
 741:../src/middleware/ftp-client/FTP_CLIENT.c ****                handler functions which do not wish to keep track of the
 742:../src/middleware/ftp-client/FTP_CLIENT.c ****                current state of the data source.
 743:../src/middleware/ftp-client/FTP_CLIENT.c ****                "dhnd_data" is the pointer that was passed to
 744:../src/middleware/ftp-client/FTP_CLIENT.c ****                ftp_data_handler().
 745:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 746:../src/middleware/ftp-client/FTP_CLIENT.c ****                "flags" contains an indicator of the current operation:
 747:../src/middleware/ftp-client/FTP_CLIENT.c ****                  FTPDH_IN : data is to be stored on this host (obtained
 748:../src/middleware/ftp-client/FTP_CLIENT.c ****                    from an FTP download).
 749:../src/middleware/ftp-client/FTP_CLIENT.c ****                  FTPDH_OUT : data is to be filled with the next data
 750:../src/middleware/ftp-client/FTP_CLIENT.c ****                    to upload to the FTP server.
 751:../src/middleware/ftp-client/FTP_CLIENT.c ****                  FTPDH_END : data and len are irrelevant: this marks
 752:../src/middleware/ftp-client/FTP_CLIENT.c ****                    the end of data, and gives the function an
 753:../src/middleware/ftp-client/FTP_CLIENT.c ****                    opportunity to e.g. close the file.  Called after
 754:../src/middleware/ftp-client/FTP_CLIENT.c ****                    either in or out processing.
 755:../src/middleware/ftp-client/FTP_CLIENT.c ****                  FTPDH_ABORT : end of data; error encountered during
 756:../src/middleware/ftp-client/FTP_CLIENT.c ****                    FTP operation.  Similar to END except the transfer
 757:../src/middleware/ftp-client/FTP_CLIENT.c ****                    did not complete.  Can use this to e.g. delete a
 758:../src/middleware/ftp-client/FTP_CLIENT.c ****                    partially written file.
 759:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 760:../src/middleware/ftp-client/FTP_CLIENT.c ****                The return value from this function depends on the in/out
 761:../src/middleware/ftp-client/FTP_CLIENT.c ****                flag.  For FTPDH_IN, the function should return 'len'
 762:../src/middleware/ftp-client/FTP_CLIENT.c ****                if the data was processed successfully and download should
 763:../src/middleware/ftp-client/FTP_CLIENT.c ****                continue; -1 if an error has occurred and the transfer
 764:../src/middleware/ftp-client/FTP_CLIENT.c ****                should be aborted.  For FTPDH_OUT, the function should
 765:../src/middleware/ftp-client/FTP_CLIENT.c ****                return the actual number of bytes placed in the data
 766:../src/middleware/ftp-client/FTP_CLIENT.c ****                buffer, or -1 to abort.  If 0 is returned, then the
 767:../src/middleware/ftp-client/FTP_CLIENT.c ****                upload is terminated normally.  For FTPDH_END, the
 768:../src/middleware/ftp-client/FTP_CLIENT.c ****                return code should be 0 for success or -1 for error.  If
 769:../src/middleware/ftp-client/FTP_CLIENT.c ****                an error is flagged, then this is used as the return code
 770:../src/middleware/ftp-client/FTP_CLIENT.c ****                for ftp_client_tick().  For FTPDH_ABORT, the return code
 771:../src/middleware/ftp-client/FTP_CLIENT.c ****                is ignored.
 772:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 773:../src/middleware/ftp-client/FTP_CLIENT.c ****                When FTP_CLIENT_KEEPALIVE_WAITTIME is defined (as an
 774:../src/middleware/ftp-client/FTP_CLIENT.c ****                integer value strictly greater than zero) then TCP
 775:../src/middleware/ftp-client/FTP_CLIENT.c ****                keepalives at the specified seconds interval are enabled
 776:../src/middleware/ftp-client/FTP_CLIENT.c ****                on the FTP client's control and data sockets.
 777:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 778:../src/middleware/ftp-client/FTP_CLIENT.c **** PARAMETER1:    Pointer to data handler function, or NULL to remove
 779:../src/middleware/ftp-client/FTP_CLIENT.c ****                the current data handler.
 780:../src/middleware/ftp-client/FTP_CLIENT.c **** PARAMETER2:    A pointer which is passed to the data handler function.
 781:../src/middleware/ftp-client/FTP_CLIENT.c ****                This may be used to point to any further data required by
 782:../src/middleware/ftp-client/FTP_CLIENT.c ****                the data handler such as an open file descriptor.
 783:../src/middleware/ftp-client/FTP_CLIENT.c **** PARAMETER3:    Options word (currently reserved, set to zero).
 784:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 785:../src/middleware/ftp-client/FTP_CLIENT.c **** SEE ALSO:      ftp_client_setup
 786:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 787:../src/middleware/ftp-client/FTP_CLIENT.c **** END DESCRIPTION **********************************************************/
 788:../src/middleware/ftp-client/FTP_CLIENT.c **** 
