 860:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 861:../src/middleware/ftp-client/FTP_CLIENT.c **** /* START FUNCTION DESCRIPTION ********************************************
 862:../src/middleware/ftp-client/FTP_CLIENT.c **** ftp_client_tick                   <FTP_CLIENT.LIB>
 863:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 864:../src/middleware/ftp-client/FTP_CLIENT.c **** SYNTAX: int ftp_client_tick(void);
 865:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 866:../src/middleware/ftp-client/FTP_CLIENT.c **** KEYWORDS:       tcpip, ftp
 867:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 868:../src/middleware/ftp-client/FTP_CLIENT.c **** DESCRIPTION:    Tick function to run the ftp. Must be called periodically.
 869:../src/middleware/ftp-client/FTP_CLIENT.c ****                The return codes are not very specific.  You can call
 870:../src/middleware/ftp-client/FTP_CLIENT.c ****                ftp_last_code() to get the integer
 871:../src/middleware/ftp-client/FTP_CLIENT.c ****                value of the last FTP message received from the server.
 872:../src/middleware/ftp-client/FTP_CLIENT.c ****                See RFC959 for details.  For example, code 530 means that
 873:../src/middleware/ftp-client/FTP_CLIENT.c ****                the client was not logged in to the server.
 874:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 875:../src/middleware/ftp-client/FTP_CLIENT.c ****                When FTP_CLIENT_KEEPALIVE_WAITTIME is defined (as an
 876:../src/middleware/ftp-client/FTP_CLIENT.c ****                integer value strictly greater than zero) then TCP
 877:../src/middleware/ftp-client/FTP_CLIENT.c ****                keepalives at the specified seconds interval are enabled
 878:../src/middleware/ftp-client/FTP_CLIENT.c ****                on the FTP client's control and data sockets.
 879:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 880:../src/middleware/ftp-client/FTP_CLIENT.c **** RETURN VALUE:   FTPC_AGAIN (0): still pending, call again
 881:../src/middleware/ftp-client/FTP_CLIENT.c ****                FTPC_OK (1): success
 882:../src/middleware/ftp-client/FTP_CLIENT.c ****                FTPC_ERROR (2): failure (call ftp_last_code() for more
 883:../src/middleware/ftp-client/FTP_CLIENT.c ****                  details).
 884:../src/middleware/ftp-client/FTP_CLIENT.c ****                FTPC_NOHOST (3): failure (Couldn't connect to server)
 885:../src/middleware/ftp-client/FTP_CLIENT.c ****                FTPC_NOBUF (4): failure (no buffer or data handler)
 886:../src/middleware/ftp-client/FTP_CLIENT.c ****                FTPC_TIMEOUT (5): warning (Timed out on close: data may or
 887:../src/middleware/ftp-client/FTP_CLIENT.c ****                  may not be OK)
 888:../src/middleware/ftp-client/FTP_CLIENT.c ****                FTPC_DHERROR (6): error (Data handler error in FTPDH_END
 889:../src/middleware/ftp-client/FTP_CLIENT.c ****                  operation)
 890:../src/middleware/ftp-client/FTP_CLIENT.c ****                FTPC_CANCELLED (7): FTP control socket was aborted (reset)
 891:../src/middleware/ftp-client/FTP_CLIENT.c ****                  by the server.
 892:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 893:../src/middleware/ftp-client/FTP_CLIENT.c **** SEE ALSO:      ftp_client_setup, ftp_client_filesize, ftp_client_xfer,
 894:../src/middleware/ftp-client/FTP_CLIENT.c ****                ftp_last_code
 895:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 896:../src/middleware/ftp-client/FTP_CLIENT.c **** END DESCRIPTION **********************************************************/
