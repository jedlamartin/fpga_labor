 529:../src/middleware/ftp-client/FTP_CLIENT.c **** ftp_client_setup                   <FTP_CLIENT.LIB>
 530:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 531:../src/middleware/ftp-client/FTP_CLIENT.c **** SYNTAX: int ftp_client_setup(
 532:../src/middleware/ftp-client/FTP_CLIENT.c ****                 long host, int port, const char far *username,
 533:../src/middleware/ftp-client/FTP_CLIENT.c ****                 const char far *password, int mode, const char far *filename,
 534:../src/middleware/ftp-client/FTP_CLIENT.c ****                 const char far *dir, char *buffer, int length
 535:../src/middleware/ftp-client/FTP_CLIENT.c ****                 );
 536:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 537:../src/middleware/ftp-client/FTP_CLIENT.c **** KEYWORDS:       tcpip, ftp
 538:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 539:../src/middleware/ftp-client/FTP_CLIENT.c **** DESCRIPTION:    Sets up a FTP transfer. It is called first, then
 540:../src/middleware/ftp-client/FTP_CLIENT.c ****                ftp_client_tick is called until it returns non-zero.
 541:../src/middleware/ftp-client/FTP_CLIENT.c ****                Failure can occur if the host address is zero, if the
 542:../src/middleware/ftp-client/FTP_CLIENT.c ****                length is negative, or if the internal control socket
 543:../src/middleware/ftp-client/FTP_CLIENT.c ****                to the FTP server cannot be opened (e.g. because of
 544:../src/middleware/ftp-client/FTP_CLIENT.c ****                lack of socket buffers).
 545:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 546:../src/middleware/ftp-client/FTP_CLIENT.c ****                When FTP_CLIENT_KEEPALIVE_WAITTIME is defined (as an
 547:../src/middleware/ftp-client/FTP_CLIENT.c ****                integer value strictly greater than zero) then TCP
 548:../src/middleware/ftp-client/FTP_CLIENT.c ****                keepalives at the specified seconds interval are enabled
 549:../src/middleware/ftp-client/FTP_CLIENT.c ****                on the FTP client's control and data sockets.
 550:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 551:../src/middleware/ftp-client/FTP_CLIENT.c **** PARAMETER1:    Host IP address of FTP server
 552:../src/middleware/ftp-client/FTP_CLIENT.c **** PARAMETER2:    Port of FTP server, 0 for default
 553:../src/middleware/ftp-client/FTP_CLIENT.c **** PARAMETER3:    Username of account on FTP server
 554:../src/middleware/ftp-client/FTP_CLIENT.c **** PARAMETER4:    Password of account on FTP server
 555:../src/middleware/ftp-client/FTP_CLIENT.c **** PARAMETER5:    Mode of transfer: FTP_MODE_UPLOAD or FTP_MODE_DOWNLOAD.
 556:../src/middleware/ftp-client/FTP_CLIENT.c ****                You may also OR in the value FTP_MODE_PASSIVE to use
 557:../src/middleware/ftp-client/FTP_CLIENT.c ****                passive mode transfer (important if you are behind a
 558:../src/middleware/ftp-client/FTP_CLIENT.c ****                firewall).
 559:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 560:../src/middleware/ftp-client/FTP_CLIENT.c ****                Use FTP_MODE_GETLIST if you just want to retrieve the file
 561:../src/middleware/ftp-client/FTP_CLIENT.c ****                information given by "LIST filename." If FTP_MODE_GETLIST is
 562:../src/middleware/ftp-client/FTP_CLIENT.c ****                used with a NULL filename the, the results of "LIST" are
 563:../src/middleware/ftp-client/FTP_CLIENT.c ****                given. These results may just be a list of file names, or
 564:../src/middleware/ftp-client/FTP_CLIENT.c ****                they may contain more information with each file - this is
 565:../src/middleware/ftp-client/FTP_CLIENT.c ****                server-dependent.
 566:../src/middleware/ftp-client/FTP_CLIENT.c **** PARAMETER6:    Filename to get/put
 567:../src/middleware/ftp-client/FTP_CLIENT.c **** PARAMETER7:    Directory file is in, NULL for default directory
 568:../src/middleware/ftp-client/FTP_CLIENT.c **** PARAMETER8:    Buffer to get/put the file to/from.  Must be NULL if
 569:../src/middleware/ftp-client/FTP_CLIENT.c ****                a data handler function will be used.  See ftp_data_handler
 570:../src/middleware/ftp-client/FTP_CLIENT.c ****                for more details.
 571:../src/middleware/ftp-client/FTP_CLIENT.c **** PARAMETER9:    On upload, length of file; on download size of buffer.
 572:../src/middleware/ftp-client/FTP_CLIENT.c ****                This parameter limits the transfer size to a maximum of
 573:../src/middleware/ftp-client/FTP_CLIENT.c ****                0x7FFFFFFF bytes.  For larger transfers, set length to 0 and
 574:../src/middleware/ftp-client/FTP_CLIENT.c ****                use a data handler function.
 575:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 576:../src/middleware/ftp-client/FTP_CLIENT.c **** RETURN VALUE:   0 on success, 1 on failure
 577:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 578:../src/middleware/ftp-client/FTP_CLIENT.c **** SEE ALSO:      ftp_client_setup_url, ftp_client_tick, ftp_data_handler
 579:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 580:../src/middleware/ftp-client/FTP_CLIENT.c **** END DESCRIPTION **********************************************************/
 581:../src/middleware/ftp-client/FTP_CLIENT.c **** 
