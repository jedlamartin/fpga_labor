  68:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****     /*
  69:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****      * Init includes toggling the reset line which is connected to GPIO 0 pin 12.
  70:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****      * This is the only pin I can see on the 16 GPIO which is currently set as an.
  71:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****      * output. We will hard code the setup here to avoid having to have a GPIO
  72:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****      * driver as well...
  73:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****      *
  74:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****      * The Aloe board is strapped for unmanaged mode and needs two pulses of the
  75:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****      * reset line to configure the device properly.
  76:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****      *
  77:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****      * The RX_CLK, TX_CLK and RXD7 pins are strapped high and the remainder low.
  78:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****      * This selects GMII mode with auto 10/100/1000 and 125MHz clkout.
  79:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****      */
  80:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****     g_aloe_gpio->OUTPUT_EN |= 0x00001000UL; /* Configure pin 12 as an output */
  81:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****     g_aloe_gpio->OUTPUT_VAL &= 0x0000EFFFUL; /* Clear pin 12 to reset PHY */
  82:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****     for (loop = 0U; loop != 1000U; loop++) /* Short delay, I'm not sure how much is needed... */
  83:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****     {
  84:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****         ;
  85:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****     }
  86:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****     g_aloe_gpio->OUTPUT_VAL |= 0x00001000UL; /* Take PHY^ out of reset */
  87:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****     for (loop = 0U; loop != 1000U; loop++) /* Short delay, I'm not sure how much is needed... */
  88:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****     {
  89:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****         ;
  90:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****     }
  91:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****     g_aloe_gpio->OUTPUT_VAL &= 0x0000EFFFUL; /* Second reset pulse */
  92:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****     for (loop = 0U; loop != 1000U; loop++) /* Short delay, I'm not sure how much is needed... */
  93:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****     {
  94:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****         ;
  95:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****     }
  96:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****     g_aloe_gpio->OUTPUT_VAL |= 0x00001000UL; /* Out of reset once more */
  97:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c **** 
  98:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****     /* Need at least 15mS delay before accessing PHY after reset... */
  99:../src/platform/drivers/mss/mss_ethernet_mac/vsc8541_phy.c ****     for (loop = 0U; loop != 10000000U; loop++) /* Long delay, I'm not sure how much is needed... */
