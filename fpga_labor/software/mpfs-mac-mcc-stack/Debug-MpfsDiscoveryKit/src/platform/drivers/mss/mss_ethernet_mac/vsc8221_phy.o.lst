  93:../src/platform/drivers/mss/mss_ethernet_mac/vsc8221_phy.c ****         /*
  94:../src/platform/drivers/mss/mss_ethernet_mac/vsc8221_phy.c ****          * Multiple MACs may be involved and we need to ensure all relevant MACs
  95:../src/platform/drivers/mss/mss_ethernet_mac/vsc8221_phy.c ****          * have the phy_hard_reset_done flag set
  96:../src/platform/drivers/mss/mss_ethernet_mac/vsc8221_phy.c ****          */
  97:../src/platform/drivers/mss/mss_ethernet_mac/vsc8221_phy.c **** 
  98:../src/platform/drivers/mss/mss_ethernet_mac/vsc8221_phy.c ****         if (phy_mac != this_mac) /* Simple case, set flag for all 4 MACs */
  99:../src/platform/drivers/mss/mss_ethernet_mac/vsc8221_phy.c ****         {
 100:../src/platform/drivers/mss/mss_ethernet_mac/vsc8221_phy.c ****             g_mac0.phy_hard_reset_done = true;
 101:../src/platform/drivers/mss/mss_ethernet_mac/vsc8221_phy.c ****             g_emac0.phy_hard_reset_done = true;
 102:../src/platform/drivers/mss/mss_ethernet_mac/vsc8221_phy.c ****             g_mac1.phy_hard_reset_done = true;
 103:../src/platform/drivers/mss/mss_ethernet_mac/vsc8221_phy.c ****             g_emac1.phy_hard_reset_done = true;
 104:../src/platform/drivers/mss/mss_ethernet_mac/vsc8221_phy.c ****         }
 105:../src/platform/drivers/mss/mss_ethernet_mac/vsc8221_phy.c ****         else if ((&g_mac0 == phy_mac) || (&g_emac0 == phy_mac))
