 355:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c ****     0x0000U, /* 00 PCS Control 1 Register */
 356:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c ****     0x0003U,
 357:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c ****     0x0001U, /* 01 PCS Control 1 Register */
 358:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c ****     0x0003U,
 359:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c ****     0x0014U, /* 02 PCS Control 1 Register */
 360:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c ****     0x0003U,
 361:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c ****     0x0016U, /* 03 PCS Control 1 Register */
