 334:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c **** /*
 335:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c ****  * RTL8211FS-CG PHY has 32 standard registers plus additional registers accessed
 336:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c ****  * via pages set from register 0x1F. Additionally there are MMD registers
 337:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c ****  * accessed indirectly through registers 0x0D and 0x0E. Register 0x0D (REGCR)
 338:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c ****  * holds the control bits which determine what device is selected and what
 339:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c ****  * register 0x0E (ADDAR) does.
 340:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c ****  *
 341:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c ****  * The following extended registers are available:
 342:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c ****  *
 343:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c ****  * Device : Offset : Access : Name    : Description
 344:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c ****  *    3   :    0   :   RW   : PC1R    : PCS Control 1 Register
 345:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c ****  *    3   :    1   :   RW   : PS1R    : PCS Status 1 Register
 346:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c ****  *    3   :   20   :   RO   : EEECR   : EEE Capability Register
 347:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c ****  *    3   :   22   :   RC   : EEEWER  : EEE Wake Error Register
 348:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c ****  *    7   :   60   :   RW   : EEEAR   : EEE Advertisement Register
 349:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c ****  *    7   :   61   :   RO   : EEELPAR : EEE Link Pertner Ability Register
 350:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c ****  *
 351:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c ****  */
 352:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c **** 
