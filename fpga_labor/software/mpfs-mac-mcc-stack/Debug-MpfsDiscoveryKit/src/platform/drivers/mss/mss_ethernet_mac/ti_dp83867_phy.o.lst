 328:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c **** /*
 329:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * TI DP83867 PHY has 32 standard registers and a collection of additional
 330:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * registers that are accessed through the use of registers 0x0D and 0x0E.
 331:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * Register 0x0D (REGCR) holds the control bits which determine what register
 332:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x0E (ADDAR) does. For the TI PHY the DEVAD field in REGCR is set to 0x1F.
 333:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  *
 334:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * The following extended registers are available:
 335:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  *
 336:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x0025 - Testmode Channel Control
 337:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x002D - Fast Link Drop Configuration
 338:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x0031 - Configuration Register 4
 339:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x0032 - RGMII Control Register
 340:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x0033 - RGMII Control Register 2
 341:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x0037 - SGMII Auto-Negotiation Status
 342:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x0043 - 100BASE-TX Configuration
 343:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x0055 - Skew FIFO Status
 344:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x006E - Strap Configuration Status Register 1
 345:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x006F - Strap Configuration Status Register 2
 346:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x0071 - BIST Control and Status Register 1
 347:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x0072 - BIST Control and Status Register 2
 348:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x0086 - RGMII Delay Control Register
 349:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x00D3 - SGMII Control Register 1
 350:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x00E9 - Sync FIFO Control
 351:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x00FE - Loopback Configuration Register
 352:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x0134 - Receive Configuration Register
 353:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x0135 - Receive Status Register
 354:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x0136 - Pattern Match Data Register 1
 355:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x0137 - Pattern Match Data Register 2
 356:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x0138 - Pattern Match Data Register 3
 357:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x0139 - SecureOn Pass Register 1
 358:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x013A - SecureOn Pass Register 2
 359:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x013B - SecureOn Pass Register 3
 360:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x013C - 0x015B - Receive Pattern Registers 1 to 32
 361:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x015C - Receive Pattern Byte Mask Register 1
 362:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x015D - Receive Pattern Byte Mask Register 2
 363:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x015E - Receive Pattern Byte Mask Register 3
 364:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x015F - Receive Pattern Byte Mask Register 4
 365:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x0161 - Receive Pattern Control
 366:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x016F - 10M SGMII Configuration
 367:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x0170 - I/O configuration
 368:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x0172 - GPIO Mux Control Register
 369:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x0180 - TDR General Configuration Register 1
 370:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x01A7 - Advanced Link Cable Diagnostics Control Register
 371:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * 0x0000 - MMD3 PCS Control Register - indirect addressing only
 372:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  *
 373:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  */
