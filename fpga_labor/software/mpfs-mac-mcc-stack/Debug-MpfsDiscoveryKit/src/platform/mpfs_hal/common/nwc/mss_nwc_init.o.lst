  79:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          MPU setup
  80:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          PMP setup
  81:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          ABP Peripheral address setup (High/Low)
  82:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *
  83:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      */
