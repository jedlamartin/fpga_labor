 110:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****             'C','D','E','F' };
 111:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****     MSS_UART_polled_tx(uart, &hexchrs[b >> 4u] , 1);
