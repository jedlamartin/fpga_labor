 445:../src/middleware/ftp-client/FTP_CLIENT.c **** ftp_client_setup_url                   <FTP_CLIENT.LIB>
 446:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 447:../src/middleware/ftp-client/FTP_CLIENT.c **** SYNTAX:         int ftp_client_setup_url( const char far *url, int mode,
 448:../src/middleware/ftp-client/FTP_CLIENT.c ****                             char *buffer, int length);
 449:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 450:../src/middleware/ftp-client/FTP_CLIENT.c **** KEYWORDS:       tcpip, ftp
 451:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 452:../src/middleware/ftp-client/FTP_CLIENT.c **** DESCRIPTION:    Sets up a FTP transfer. It is called first, then
 453:../src/middleware/ftp-client/FTP_CLIENT.c ****                ftp_client_tick is called until it returns non-zero.
 454:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 455:../src/middleware/ftp-client/FTP_CLIENT.c **** PARAMETER1:    URL to download
 456:../src/middleware/ftp-client/FTP_CLIENT.c **** PARAMETER2:    Mode of transfer: FTP_MODE_UPLOAD or FTP_MODE_DOWNLOAD.
 457:../src/middleware/ftp-client/FTP_CLIENT.c ****                You may also OR in the value FTP_MODE_PASSIVE to use
 458:../src/middleware/ftp-client/FTP_CLIENT.c ****                passive mode transfer (important if you are behind a
 459:../src/middleware/ftp-client/FTP_CLIENT.c ****                firewall).
 460:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 461:../src/middleware/ftp-client/FTP_CLIENT.c ****                Use FTP_MODE_GETLIST if you just want to retrieve the file
 462:../src/middleware/ftp-client/FTP_CLIENT.c ****                information given by "LIST filename." If FTP_MODE_GETLIST is
 463:../src/middleware/ftp-client/FTP_CLIENT.c ****                used with a NULL filename the, the results of "LIST" are
 464:../src/middleware/ftp-client/FTP_CLIENT.c ****                given. These results may just be a list of file names, or
 465:../src/middleware/ftp-client/FTP_CLIENT.c ****                they may contain more information with each file - this is
 466:../src/middleware/ftp-client/FTP_CLIENT.c ****                server-dependent.
 467:../src/middleware/ftp-client/FTP_CLIENT.c **** PARAMETER3:    Buffer to get/put the file to/from.  Must be NULL if
 468:../src/middleware/ftp-client/FTP_CLIENT.c ****                a data handler function will be used.  See ftp_data_handler
 469:../src/middleware/ftp-client/FTP_CLIENT.c ****                for more details.
 470:../src/middleware/ftp-client/FTP_CLIENT.c **** PARAMETER4:    On upload, length of file; on download size of buffer.
 471:../src/middleware/ftp-client/FTP_CLIENT.c ****                This parameter limits the transfer size to a maximum of
 472:../src/middleware/ftp-client/FTP_CLIENT.c ****                32767 bytes.  For larger transfers, it will be necessary
 473:../src/middleware/ftp-client/FTP_CLIENT.c ****                to use a data handler function.
 474:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 475:../src/middleware/ftp-client/FTP_CLIENT.c **** RETURN VALUE:   0: Success
 476:../src/middleware/ftp-client/FTP_CLIENT.c ****                     -NETERR_DNSERROR: Couldn't resolve hostname from URL.
 477:../src/middleware/ftp-client/FTP_CLIENT.c ****                     -NETERR_HOST_REFUSED: Couldn't connect to FTP server.
 478:../src/middleware/ftp-client/FTP_CLIENT.c ****                -EINVAL: Error parsing URL
 479:../src/middleware/ftp-client/FTP_CLIENT.c ****                -E2BIG: URL is too big to parse.  Increase URL_MAX_BUFFER_SIZE
 480:../src/middleware/ftp-client/FTP_CLIENT.c ****                      to handle larger URLs.
 481:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 482:../src/middleware/ftp-client/FTP_CLIENT.c **** SEE ALSO:      ftp_client_setup, ftp_client_tick, ftp_data_handler
 483:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 484:../src/middleware/ftp-client/FTP_CLIENT.c **** END DESCRIPTION **********************************************************/
 485:../src/middleware/ftp-client/FTP_CLIENT.c **** int ftp_client_setup_url( const char *url, int mode, char *buffer, int length)
 486:../src/middleware/ftp-client/FTP_CLIENT.c **** {
 487:../src/middleware/ftp-client/FTP_CLIENT.c ****     url_parsed_t parsed;
 488:../src/middleware/ftp-client/FTP_CLIENT.c ****     int error;
 489:../src/middleware/ftp-client/FTP_CLIENT.c ****     unsigned long ip;
 490:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 491:../src/middleware/ftp-client/FTP_CLIENT.c ****     error = url_parse( &parsed, url);
 492:../src/middleware/ftp-client/FTP_CLIENT.c ****     if (! error)
 493:../src/middleware/ftp-client/FTP_CLIENT.c ****     {
 494:../src/middleware/ftp-client/FTP_CLIENT.c ****         if ( !(ip = resolve( parsed.hostname)) )
 495:../src/middleware/ftp-client/FTP_CLIENT.c ****         {
 496:../src/middleware/ftp-client/FTP_CLIENT.c ****             error = -NETERR_DNSERROR;
 497:../src/middleware/ftp-client/FTP_CLIENT.c ****         }
 498:../src/middleware/ftp-client/FTP_CLIENT.c ****         else
 499:../src/middleware/ftp-client/FTP_CLIENT.c ****         {
 500:../src/middleware/ftp-client/FTP_CLIENT.c ****           if (!*parsed.username)
 501:../src/middleware/ftp-client/FTP_CLIENT.c ****           {
 502:../src/middleware/ftp-client/FTP_CLIENT.c ****              parsed.username = "ftp";
 503:../src/middleware/ftp-client/FTP_CLIENT.c ****           }
 504:../src/middleware/ftp-client/FTP_CLIENT.c ****           else if (*parsed.password)
 505:../src/middleware/ftp-client/FTP_CLIENT.c ****             {
 506:../src/middleware/ftp-client/FTP_CLIENT.c ****                 // split userinfo into username and password
 507:../src/middleware/ftp-client/FTP_CLIENT.c ****                 parsed.password[-1] = '\0';
 508:../src/middleware/ftp-client/FTP_CLIENT.c ****             }
 509:../src/middleware/ftp-client/FTP_CLIENT.c ****             if (*parsed.filename)
 510:../src/middleware/ftp-client/FTP_CLIENT.c ****             {
 511:../src/middleware/ftp-client/FTP_CLIENT.c ****                 // split path into path and filename
 512:../src/middleware/ftp-client/FTP_CLIENT.c ****                 parsed.filename[-1] = '\0';
 513:../src/middleware/ftp-client/FTP_CLIENT.c ****             }
 514:../src/middleware/ftp-client/FTP_CLIENT.c ****           error = ftp_client_setup (ip, parsed.port, parsed.username,
 515:../src/middleware/ftp-client/FTP_CLIENT.c ****             parsed.password, mode, parsed.filename, parsed.path,
 516:../src/middleware/ftp-client/FTP_CLIENT.c ****             buffer, length);
 517:../src/middleware/ftp-client/FTP_CLIENT.c ****           if (error)
 518:../src/middleware/ftp-client/FTP_CLIENT.c ****           {
 519:../src/middleware/ftp-client/FTP_CLIENT.c ****                 error = -NETERR_HOST_REFUSED;
 520:../src/middleware/ftp-client/FTP_CLIENT.c ****           }
 521:../src/middleware/ftp-client/FTP_CLIENT.c ****         }
 522:../src/middleware/ftp-client/FTP_CLIENT.c ****     }
 523:../src/middleware/ftp-client/FTP_CLIENT.c **** 
 524:../src/middleware/ftp-client/FTP_CLIENT.c ****     return error;
 525:../src/middleware/ftp-client/FTP_CLIENT.c **** }
 526:../src/middleware/ftp-client/FTP_CLIENT.c **** #endif
 527:../src/middleware/ftp-client/FTP_CLIENT.c **** 
