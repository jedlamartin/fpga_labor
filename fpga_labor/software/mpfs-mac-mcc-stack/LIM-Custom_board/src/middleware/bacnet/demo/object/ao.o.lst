  40:../src/middleware/bacnet/demo/object/ao.c **** #ifndef MAX_ANALOG_OUTPUTS
  41:../src/middleware/bacnet/demo/object/ao.c **** #define MAX_ANALOG_OUTPUTS 4
  42:../src/middleware/bacnet/demo/object/ao.c **** #endif
  43:../src/middleware/bacnet/demo/object/ao.c **** 
  44:../src/middleware/bacnet/demo/object/ao.c **** /* we choose to have a NULL level in our system represented by */
  45:../src/middleware/bacnet/demo/object/ao.c **** /* a particular value.  When the priorities are not in use, they */
  46:../src/middleware/bacnet/demo/object/ao.c **** /* will be relinquished (i.e. set to the NULL level). */
  47:../src/middleware/bacnet/demo/object/ao.c **** #define AO_LEVEL_NULL 255
  48:../src/middleware/bacnet/demo/object/ao.c **** /* When all the priorities are level null, the present value returns */
  49:../src/middleware/bacnet/demo/object/ao.c **** /* the Relinquish Default value */
  50:../src/middleware/bacnet/demo/object/ao.c **** #define AO_RELINQUISH_DEFAULT 0
  51:../src/middleware/bacnet/demo/object/ao.c **** /* Here is our Priority Array.  They are supposed to be Real, but */
  52:../src/middleware/bacnet/demo/object/ao.c **** /* we don't have that kind of memory, so we will use a single byte */
  53:../src/middleware/bacnet/demo/object/ao.c **** /* and load a Real for returning the value when asked. */
  54:../src/middleware/bacnet/demo/object/ao.c **** static uint8_t Analog_Output_Level[MAX_ANALOG_OUTPUTS][BACNET_MAX_PRIORITY];
  55:../src/middleware/bacnet/demo/object/ao.c **** /* Writable out-of-service allows others to play with our Present Value */
  56:../src/middleware/bacnet/demo/object/ao.c **** /* without changing the physical output */
  57:../src/middleware/bacnet/demo/object/ao.c **** static bool Out_Of_Service[MAX_ANALOG_OUTPUTS];
  58:../src/middleware/bacnet/demo/object/ao.c **** 
  59:../src/middleware/bacnet/demo/object/ao.c **** /* we need to have our arrays initialized before answering any calls */
  60:../src/middleware/bacnet/demo/object/ao.c **** static bool Analog_Output_Initialized = false;
  61:../src/middleware/bacnet/demo/object/ao.c **** 
