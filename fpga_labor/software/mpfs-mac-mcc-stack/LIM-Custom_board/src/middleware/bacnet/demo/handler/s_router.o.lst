 314:../src/middleware/bacnet/demo/handler/s_router.c **** /** Sends our Routing Table, built from our DNET[] array, as an ACK.
 315:../src/middleware/bacnet/demo/handler/s_router.c ****  * There are two cases here:
 316:../src/middleware/bacnet/demo/handler/s_router.c ****  * 1) We are responding to a NETWORK_MESSAGE_INIT_RT_TABLE requesting our table.
 317:../src/middleware/bacnet/demo/handler/s_router.c ****  *    We will normally broadcast that response.
 318:../src/middleware/bacnet/demo/handler/s_router.c ****  * 2) We are ACKing the receipt of a NETWORK_MESSAGE_INIT_RT_TABLE containing a
 319:../src/middleware/bacnet/demo/handler/s_router.c ****  *    routing table, and then we will want to respond to that dst router.
 320:../src/middleware/bacnet/demo/handler/s_router.c ****  *    In that case, DNET[] should just have one entry of -1 (no routing table
 321:../src/middleware/bacnet/demo/handler/s_router.c ****  *    is sent).
 322:../src/middleware/bacnet/demo/handler/s_router.c ****  * @ingroup NMRC
 323:../src/middleware/bacnet/demo/handler/s_router.c ****  *
 324:../src/middleware/bacnet/demo/handler/s_router.c ****  * @param dst [in] If NULL, Ack will be broadcast to the local BACnet network.
 325:../src/middleware/bacnet/demo/handler/s_router.c ****  *                 Optionally may designate a particular router destination,
 326:../src/middleware/bacnet/demo/handler/s_router.c ****  *                 especially when ACKing receipt of this message type.
 327:../src/middleware/bacnet/demo/handler/s_router.c ****  * @param DNET_list [in] List of BACnet network numbers for which I am a router,
 328:../src/middleware/bacnet/demo/handler/s_router.c ****  *                       terminated with -1.  May be just -1 when no table
 329:../src/middleware/bacnet/demo/handler/s_router.c ****  *                       should be sent.
 330:../src/middleware/bacnet/demo/handler/s_router.c ****  */
 331:../src/middleware/bacnet/demo/handler/s_router.c **** void Send_Initialize_Routing_Table_Ack(
