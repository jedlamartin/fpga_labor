  25:../src/middleware/bacnet/demo/object/device-client.c **** 
  26:../src/middleware/bacnet/demo/object/device-client.c **** /** @file device-client.c Lightweight base "class" for handling all
  27:../src/middleware/bacnet/demo/object/device-client.c ****  * BACnet objects belonging to a BACnet device, as well as
  28:../src/middleware/bacnet/demo/object/device-client.c ****  * Device-specific properties.  This Device instance is designed to
  29:../src/middleware/bacnet/demo/object/device-client.c ****  * meet minimal functionality for simple clients. */
  30:../src/middleware/bacnet/demo/object/device-client.c **** 
  31:../src/middleware/bacnet/demo/object/device-client.c **** #include <stdbool.h>
  32:../src/middleware/bacnet/demo/object/device-client.c **** #include <stdint.h>
  33:../src/middleware/bacnet/demo/object/device-client.c **** #include <string.h>     /* for memmove */
  34:../src/middleware/bacnet/demo/object/device-client.c **** #include <time.h>       /* for timezone, localtime */
  35:../src/middleware/bacnet/demo/object/device-client.c **** /* OS specific include*/
  36:../src/middleware/bacnet/demo/object/device-client.c **** // PMCS #include "net.h"
  37:../src/middleware/bacnet/demo/object/device-client.c **** // PMCS #include "timer.h"
  38:../src/middleware/bacnet/demo/object/device-client.c **** /* BACnet includes */
  39:../src/middleware/bacnet/demo/object/device-client.c **** #include "bacdef.h"
  40:../src/middleware/bacnet/demo/object/device-client.c **** #include "bacdcode.h"
  41:../src/middleware/bacnet/demo/object/device-client.c **** #include "bacenum.h"
  42:../src/middleware/bacnet/demo/object/device-client.c **** #include "bacapp.h"
  43:../src/middleware/bacnet/demo/object/device-client.c **** #include "config.h"     /* the custom stuff */
  44:../src/middleware/bacnet/demo/object/device-client.c **** #include "apdu.h"
  45:../src/middleware/bacnet/demo/object/device-client.c **** #include "rp.h" /* ReadProperty handling */
  46:../src/middleware/bacnet/demo/object/device-client.c **** #include "version.h"
  47:../src/middleware/bacnet/demo/object/device-client.c **** #include "handlers.h"
  48:../src/middleware/bacnet/demo/object/device-client.c **** #include "datalink.h"
  49:../src/middleware/bacnet/demo/object/device-client.c **** #include "address.h"
  50:../src/middleware/bacnet/demo/object/device-client.c **** #if (BACNET_PROTOCOL_REVISION >= 17)
  51:../src/middleware/bacnet/demo/object/device-client.c **** #include "netport.h"
  52:../src/middleware/bacnet/demo/object/device-client.c **** #endif
  53:../src/middleware/bacnet/demo/object/device-client.c **** /* include the device object */
  54:../src/middleware/bacnet/demo/object/device-client.c **** #include "device.h"     /* me */
  55:../src/middleware/bacnet/demo/object/device-client.c **** #include "ai.h"
  56:../src/middleware/bacnet/demo/object/device-client.c **** #include "ao.h"
  57:../src/middleware/bacnet/demo/object/device-client.c **** #include "av.h"
  58:../src/middleware/bacnet/demo/object/device-client.c **** #include "bi.h"
  59:../src/middleware/bacnet/demo/object/device-client.c **** #include "bo.h"
  60:../src/middleware/bacnet/demo/object/device-client.c **** #include "bv.h"
  61:../src/middleware/bacnet/demo/object/device-client.c **** 
  62:../src/middleware/bacnet/demo/object/device-client.c **** #if defined(__BORLANDC__) || defined(_WIN32)
  63:../src/middleware/bacnet/demo/object/device-client.c **** /* seems to not be defined in time.h as specified by The Open Group */
  64:../src/middleware/bacnet/demo/object/device-client.c **** /* difference from UTC and local standard time  */
  65:../src/middleware/bacnet/demo/object/device-client.c **** long int timezone;
  66:../src/middleware/bacnet/demo/object/device-client.c **** #endif
  67:../src/middleware/bacnet/demo/object/device-client.c **** 
  68:../src/middleware/bacnet/demo/object/device-client.c **** /* note: you really only need to define variables for
  69:../src/middleware/bacnet/demo/object/device-client.c ****    properties that are writable or that may change.
  70:../src/middleware/bacnet/demo/object/device-client.c ****    The properties that are constant can be hard coded
  71:../src/middleware/bacnet/demo/object/device-client.c ****    into the read-property encoding. */
  72:../src/middleware/bacnet/demo/object/device-client.c **** 
  73:../src/middleware/bacnet/demo/object/device-client.c **** static uint32_t Object_Instance_Number = 260001;
  74:../src/middleware/bacnet/demo/object/device-client.c **** static BACNET_CHARACTER_STRING My_Object_Name;
  75:../src/middleware/bacnet/demo/object/device-client.c **** static BACNET_DEVICE_STATUS System_Status = STATUS_OPERATIONAL;
  76:../src/middleware/bacnet/demo/object/device-client.c **** static char *Vendor_Name = BACNET_VENDOR_NAME;
  77:../src/middleware/bacnet/demo/object/device-client.c **** static uint16_t Vendor_Identifier = BACNET_VENDOR_ID;
  78:../src/middleware/bacnet/demo/object/device-client.c **** static char *Model_Name = "GNU";
  79:../src/middleware/bacnet/demo/object/device-client.c **** static char *Application_Software_Version = "1.0";
  80:../src/middleware/bacnet/demo/object/device-client.c **** static char *Location = "USA";
  81:../src/middleware/bacnet/demo/object/device-client.c **** static char *Description = "command line client";
  82:../src/middleware/bacnet/demo/object/device-client.c **** /* static uint8_t Protocol_Version = 1; - constant, not settable */
  83:../src/middleware/bacnet/demo/object/device-client.c **** /* static uint8_t Protocol_Revision = 4; - constant, not settable */
  84:../src/middleware/bacnet/demo/object/device-client.c **** /* Protocol_Services_Supported - dynamically generated */
  85:../src/middleware/bacnet/demo/object/device-client.c **** /* Protocol_Object_Types_Supported - in RP encoding */
  86:../src/middleware/bacnet/demo/object/device-client.c **** /* Object_List - dynamically generated */
  87:../src/middleware/bacnet/demo/object/device-client.c **** /* static BACNET_SEGMENTATION Segmentation_Supported = SEGMENTATION_NONE; */
  88:../src/middleware/bacnet/demo/object/device-client.c **** /* static uint8_t Max_Segments_Accepted = 0; */
  89:../src/middleware/bacnet/demo/object/device-client.c **** /* VT_Classes_Supported */
  90:../src/middleware/bacnet/demo/object/device-client.c **** /* Active_VT_Sessions */
  91:../src/middleware/bacnet/demo/object/device-client.c **** static BACNET_TIME Local_Time;  /* rely on OS, if there is one */
  92:../src/middleware/bacnet/demo/object/device-client.c **** static BACNET_DATE Local_Date;  /* rely on OS, if there is one */
  93:../src/middleware/bacnet/demo/object/device-client.c **** /* NOTE: BACnet UTC Offset is inverse of common practice.
  94:../src/middleware/bacnet/demo/object/device-client.c ****    If your UTC offset is -5hours of GMT,
  95:../src/middleware/bacnet/demo/object/device-client.c ****    then BACnet UTC offset is +5hours.
  96:../src/middleware/bacnet/demo/object/device-client.c ****    BACnet UTC offset is expressed in minutes. */
  97:../src/middleware/bacnet/demo/object/device-client.c **** static int32_t UTC_Offset = 5 * 60;
  98:../src/middleware/bacnet/demo/object/device-client.c **** static bool Daylight_Savings_Status = false;    /* rely on OS */
  99:../src/middleware/bacnet/demo/object/device-client.c **** #if defined(BACNET_TIME_MASTER)
 100:../src/middleware/bacnet/demo/object/device-client.c **** static bool Align_Intervals;
 101:../src/middleware/bacnet/demo/object/device-client.c **** static uint32_t Interval_Minutes;
 102:../src/middleware/bacnet/demo/object/device-client.c **** static uint32_t Interval_Offset_Minutes;
