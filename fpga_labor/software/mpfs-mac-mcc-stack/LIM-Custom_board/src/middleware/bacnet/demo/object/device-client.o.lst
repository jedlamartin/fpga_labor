1026:../src/middleware/bacnet/demo/object/device-client.c **** 
1027:../src/middleware/bacnet/demo/object/device-client.c **** /**
1028:../src/middleware/bacnet/demo/object/device-client.c ****  * Sets the time sync interval offset value.
1029:../src/middleware/bacnet/demo/object/device-client.c ****  *
1030:../src/middleware/bacnet/demo/object/device-client.c ****  * @param minutes
1031:../src/middleware/bacnet/demo/object/device-client.c ****  * This property, of type Unsigned, specifies the offset in
1032:../src/middleware/bacnet/demo/object/device-client.c ****  * minutes from the beginning of the period specified for time
1033:../src/middleware/bacnet/demo/object/device-client.c ****  * synchronization until the actual time synchronization requests
1034:../src/middleware/bacnet/demo/object/device-client.c ****  * are sent. The offset used shall be the value of Interval_Offset
1035:../src/middleware/bacnet/demo/object/device-client.c ****  * modulo the value of Time_Synchronization_Interval;
1036:../src/middleware/bacnet/demo/object/device-client.c ****  * e.g., if Interval_Offset has the value 31 and
1037:../src/middleware/bacnet/demo/object/device-client.c ****  * Time_Synchronization_Interval is 30, the offset used shall be 1.
1038:../src/middleware/bacnet/demo/object/device-client.c ****  * Interval_Offset shall have no effect if Align_Intervals is
1039:../src/middleware/bacnet/demo/object/device-client.c ****  * FALSE. If this property is present, it shall be writable.
1040:../src/middleware/bacnet/demo/object/device-client.c ****  */
1041:../src/middleware/bacnet/demo/object/device-client.c **** bool Device_Interval_Offset_Set(uint32_t minutes)
1042:../src/middleware/bacnet/demo/object/device-client.c **** {
1043:../src/middleware/bacnet/demo/object/device-client.c ****     Interval_Offset_Minutes = minutes;
1044:../src/middleware/bacnet/demo/object/device-client.c **** 
1045:../src/middleware/bacnet/demo/object/device-client.c ****     return true;
1046:../src/middleware/bacnet/demo/object/device-client.c **** }
1047:../src/middleware/bacnet/demo/object/device-client.c **** 
1048:../src/middleware/bacnet/demo/object/device-client.c **** uint32_t Device_Interval_Offset(void)
1049:../src/middleware/bacnet/demo/object/device-client.c **** {
1050:../src/middleware/bacnet/demo/object/device-client.c ****     return Interval_Offset_Minutes;
1051:../src/middleware/bacnet/demo/object/device-client.c **** }
