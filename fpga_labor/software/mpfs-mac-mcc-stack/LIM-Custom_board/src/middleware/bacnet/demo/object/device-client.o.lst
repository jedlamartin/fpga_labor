1005:../src/middleware/bacnet/demo/object/device-client.c **** /**
1006:../src/middleware/bacnet/demo/object/device-client.c ****  * Sets the time sync interval in minutes
1007:../src/middleware/bacnet/demo/object/device-client.c ****  *
1008:../src/middleware/bacnet/demo/object/device-client.c ****  * @param minutes
1009:../src/middleware/bacnet/demo/object/device-client.c ****  * This property, of type Unsigned, specifies the periodic
1010:../src/middleware/bacnet/demo/object/device-client.c ****  * interval in minutes at which TimeSynchronization and
1011:../src/middleware/bacnet/demo/object/device-client.c ****  * UTCTimeSynchronization requests shall be sent. If this
1012:../src/middleware/bacnet/demo/object/device-client.c ****  * property has a value of zero, then periodic time synchronization is
1013:../src/middleware/bacnet/demo/object/device-client.c ****  * disabled. If this property is present, it shall be writable.
1014:../src/middleware/bacnet/demo/object/device-client.c ****  */
1015:../src/middleware/bacnet/demo/object/device-client.c **** bool Device_Time_Sync_Interval_Set(uint32_t minutes)
1016:../src/middleware/bacnet/demo/object/device-client.c **** {
1017:../src/middleware/bacnet/demo/object/device-client.c ****     Interval_Minutes = minutes;
1018:../src/middleware/bacnet/demo/object/device-client.c **** 
1019:../src/middleware/bacnet/demo/object/device-client.c ****     return true;
1020:../src/middleware/bacnet/demo/object/device-client.c **** }
1021:../src/middleware/bacnet/demo/object/device-client.c **** 
1022:../src/middleware/bacnet/demo/object/device-client.c **** uint32_t Device_Time_Sync_Interval(void)
1023:../src/middleware/bacnet/demo/object/device-client.c **** {
