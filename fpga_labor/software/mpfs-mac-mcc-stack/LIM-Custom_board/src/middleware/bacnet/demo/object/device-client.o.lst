 980:../src/middleware/bacnet/demo/object/device-client.c **** #if defined(BACNET_TIME_MASTER)
 981:../src/middleware/bacnet/demo/object/device-client.c **** /**
 982:../src/middleware/bacnet/demo/object/device-client.c ****  * Sets the time sync interval in minutes
 983:../src/middleware/bacnet/demo/object/device-client.c ****  *
 984:../src/middleware/bacnet/demo/object/device-client.c ****  * @param flag
 985:../src/middleware/bacnet/demo/object/device-client.c ****  * This property, of type BOOLEAN, specifies whether (TRUE)
 986:../src/middleware/bacnet/demo/object/device-client.c ****  * or not (FALSE) clock-aligned periodic time synchronization is
 987:../src/middleware/bacnet/demo/object/device-client.c ****  * enabled. If periodic time synchronization is enabled and the
 988:../src/middleware/bacnet/demo/object/device-client.c ****  * time synchronization interval is a factor of (divides without
 989:../src/middleware/bacnet/demo/object/device-client.c ****  * remainder) an hour or day, then the beginning of the period
 990:../src/middleware/bacnet/demo/object/device-client.c ****  * specified for time synchronization shall be aligned to the hour or
 991:../src/middleware/bacnet/demo/object/device-client.c ****  * day, respectively. If this property is present, it shall be writable.
 992:../src/middleware/bacnet/demo/object/device-client.c ****  */
 993:../src/middleware/bacnet/demo/object/device-client.c **** bool Device_Align_Intervals_Set(bool flag)
 994:../src/middleware/bacnet/demo/object/device-client.c **** {
 995:../src/middleware/bacnet/demo/object/device-client.c ****     Align_Intervals = flag;
 996:../src/middleware/bacnet/demo/object/device-client.c **** 
 997:../src/middleware/bacnet/demo/object/device-client.c ****     return true;
