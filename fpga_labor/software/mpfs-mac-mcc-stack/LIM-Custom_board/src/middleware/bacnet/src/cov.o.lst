 336:../src/middleware/bacnet/src/cov.c **** 
 337:../src/middleware/bacnet/src/cov.c **** /*
 338:../src/middleware/bacnet/src/cov.c **** 12.11.38Active_COV_Subscriptions
 339:../src/middleware/bacnet/src/cov.c **** The Active_COV_Subscriptions property is a List of BACnetCOVSubscription,
 340:../src/middleware/bacnet/src/cov.c **** each of which consists of a Recipient, a Monitored Property Reference,
 341:../src/middleware/bacnet/src/cov.c **** an Issue Confirmed Notifications flag, a Time Remaining value and an
 342:../src/middleware/bacnet/src/cov.c **** optional COV Increment. This property provides a network-visible indication
 343:../src/middleware/bacnet/src/cov.c **** of those COV subscriptions that are active at any given time.
 344:../src/middleware/bacnet/src/cov.c **** Whenever a COV Subscription is created with the SubscribeCOV or
 345:../src/middleware/bacnet/src/cov.c **** SubscribeCOVProperty service, a new entry is added to
 346:../src/middleware/bacnet/src/cov.c **** the Active_COV_Subscriptions list. Similarly, whenever a COV Subscription
 347:../src/middleware/bacnet/src/cov.c **** is terminated, the corresponding entry shall be
 348:../src/middleware/bacnet/src/cov.c **** removed from the Active_COV_Subscriptions list.
 349:../src/middleware/bacnet/src/cov.c **** */
 350:../src/middleware/bacnet/src/cov.c **** /*
 351:../src/middleware/bacnet/src/cov.c **** SubscribeCOV-Request ::= SEQUENCE {
 352:../src/middleware/bacnet/src/cov.c ****         subscriberProcessIdentifier  [0] Unsigned32,
 353:../src/middleware/bacnet/src/cov.c ****         monitoredObjectIdentifier    [1] BACnetObjectIdentifier,
 354:../src/middleware/bacnet/src/cov.c ****         issueConfirmedNotifications  [2] BOOLEAN OPTIONAL,
 355:../src/middleware/bacnet/src/cov.c ****         lifetime                     [3] Unsigned OPTIONAL
 356:../src/middleware/bacnet/src/cov.c ****         }
 357:../src/middleware/bacnet/src/cov.c **** */
 358:../src/middleware/bacnet/src/cov.c **** 
