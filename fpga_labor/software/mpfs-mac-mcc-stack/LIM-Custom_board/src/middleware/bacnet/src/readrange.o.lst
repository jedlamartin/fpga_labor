  42:../src/middleware/bacnet/src/readrange.c **** /*
  43:../src/middleware/bacnet/src/readrange.c ****  * ReadRange-Request ::= SEQUENCE {
  44:../src/middleware/bacnet/src/readrange.c ****  *     objectIdentifier   [0] BACnetObjectIdentifier,
  45:../src/middleware/bacnet/src/readrange.c ****  *     propertyIdentifier [1] BACnetPropertyIdentifier,
  46:../src/middleware/bacnet/src/readrange.c ****  *     propertyArrayIndex [2] Unsigned OPTIONAL, -- used only with array datatype
  47:../src/middleware/bacnet/src/readrange.c ****  *     range CHOICE {
  48:../src/middleware/bacnet/src/readrange.c ****  *         byPosition [3] SEQUENCE {
  49:../src/middleware/bacnet/src/readrange.c ****  *             referenceIndex Unsigned, 
  50:../src/middleware/bacnet/src/readrange.c ****  *             count          INTEGER
  51:../src/middleware/bacnet/src/readrange.c ****  *         },
  52:../src/middleware/bacnet/src/readrange.c ****  *     -- context tag 4 is deprecated
  53:../src/middleware/bacnet/src/readrange.c ****  *     -- context tag 5 is deprecated
  54:../src/middleware/bacnet/src/readrange.c ****  *         bySequenceNumber [6] SEQUENCE {
  55:../src/middleware/bacnet/src/readrange.c ****  *             referenceIndex Unsigned,
  56:../src/middleware/bacnet/src/readrange.c ****  *             count          INTEGER
  57:../src/middleware/bacnet/src/readrange.c ****  *         },
  58:../src/middleware/bacnet/src/readrange.c ****  *         byTime [7] SEQUENCE {
  59:../src/middleware/bacnet/src/readrange.c ****  *             referenceTime BACnetDateTime,
  60:../src/middleware/bacnet/src/readrange.c ****  *             count         INTEGER
  61:../src/middleware/bacnet/src/readrange.c ****  *             }
  62:../src/middleware/bacnet/src/readrange.c ****  *     } OPTIONAL
  63:../src/middleware/bacnet/src/readrange.c ****  * }
  64:../src/middleware/bacnet/src/readrange.c ****  */
