   1:../src/middleware/bacnet/src/bigend.c **** /* Derived from "Unix Incompatibility Notes: Byte Order" by Jan Wolter */
   2:../src/middleware/bacnet/src/bigend.c **** /* http://unixpapa.com/incnote/byteorder.html */
   3:../src/middleware/bacnet/src/bigend.c **** 
   4:../src/middleware/bacnet/src/bigend.c **** /** @file bigend.c  Determination of Endianess */
   5:../src/middleware/bacnet/src/bigend.c **** 
   6:../src/middleware/bacnet/src/bigend.c **** #include "bigend.h"
   7:../src/middleware/bacnet/src/bigend.c **** 
   8:../src/middleware/bacnet/src/bigend.c **** /* Big-Endian systems save the most significant byte first.  */
   9:../src/middleware/bacnet/src/bigend.c **** /* Sun and Motorola processors, IBM-370s and PDP-10s are big-endian. */
  10:../src/middleware/bacnet/src/bigend.c **** /* "Network Byte Order" is also know as "Big-Endian Byte Order" */
  11:../src/middleware/bacnet/src/bigend.c **** /* for example, a 4 byte integer 67305985 is 0x04030201 in hexidecimal. */
  12:../src/middleware/bacnet/src/bigend.c **** /* x[0] = 0x04 */
  13:../src/middleware/bacnet/src/bigend.c **** /* x[1] = 0x03 */
  14:../src/middleware/bacnet/src/bigend.c **** /* x[2] = 0x02 */
  15:../src/middleware/bacnet/src/bigend.c **** /* x[3] = 0x01 */
  16:../src/middleware/bacnet/src/bigend.c **** 
  17:../src/middleware/bacnet/src/bigend.c **** /* Little-Endian systems save the least significant byte first.  */
  18:../src/middleware/bacnet/src/bigend.c **** /* The entire Intel x86 family, Vaxes, Alphas and PDP-11s are little-endian. */
  19:../src/middleware/bacnet/src/bigend.c **** /* for example, a 4 byte integer 67305985 is 0x04030201 in hexidecimal. */
  20:../src/middleware/bacnet/src/bigend.c **** /* x[0] = 0x01 */
  21:../src/middleware/bacnet/src/bigend.c **** /* x[1] = 0x02 */
  22:../src/middleware/bacnet/src/bigend.c **** /* x[2] = 0x03 */
  23:../src/middleware/bacnet/src/bigend.c **** /* x[3] = 0x04 */
  24:../src/middleware/bacnet/src/bigend.c **** 
  25:../src/middleware/bacnet/src/bigend.c **** /* Note: Endianness doesn't apply to all variable manipulation.
  26:../src/middleware/bacnet/src/bigend.c ****    If you use bitwise or bitshift operations on integers,
  27:../src/middleware/bacnet/src/bigend.c ****    you can avoid having to check for endianness. */
  28:../src/middleware/bacnet/src/bigend.c **** 
  29:../src/middleware/bacnet/src/bigend.c **** /* The names are derived from Jonathon Swift's book Gulliver's Travels,
  30:../src/middleware/bacnet/src/bigend.c ****    where they describe Lilliputian political parties who disagree
  31:../src/middleware/bacnet/src/bigend.c ****    vehemently over which end to start eating an egg from.
  32:../src/middleware/bacnet/src/bigend.c ****    This terminology was popularized for byte order by a less than
  33:../src/middleware/bacnet/src/bigend.c ****    completely serious paper authored by Danny Cohen which appeared
  34:../src/middleware/bacnet/src/bigend.c ****    on April 1, 1980 and was entitled "On Holy Wars and a Plea for Peace" */
  35:../src/middleware/bacnet/src/bigend.c **** 
  36:../src/middleware/bacnet/src/bigend.c **** /* function to return true on Big-Endian architectures */
  37:../src/middleware/bacnet/src/bigend.c **** /* (based on Harbison & Steele) */
