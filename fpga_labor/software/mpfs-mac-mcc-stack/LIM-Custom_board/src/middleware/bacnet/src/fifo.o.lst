  37:../src/middleware/bacnet/src/fifo.c **** *
  38:../src/middleware/bacnet/src/fifo.c **** * @section DESCRIPTION
  39:../src/middleware/bacnet/src/fifo.c **** *
  40:../src/middleware/bacnet/src/fifo.c **** * Generic interrupt safe FIFO library for deeply embedded system
  41:../src/middleware/bacnet/src/fifo.c **** * This library only uses a byte sized chunk for a data element.
  42:../src/middleware/bacnet/src/fifo.c **** * It uses a data store whose size is a power of 2 (8, 16, 32, 64, ...)
  43:../src/middleware/bacnet/src/fifo.c **** * and doesn't waste any data bytes.  It has very low overhead, and
  44:../src/middleware/bacnet/src/fifo.c **** * utilizes modulo for indexing the data in the data store.
  45:../src/middleware/bacnet/src/fifo.c **** *
  46:../src/middleware/bacnet/src/fifo.c **** * To use this library, first declare a data store, sized for a power of 2:
  47:../src/middleware/bacnet/src/fifo.c **** * {@code
  48:../src/middleware/bacnet/src/fifo.c **** * static volatile uint8_t data_store[64];
  49:../src/middleware/bacnet/src/fifo.c **** * }
  50:../src/middleware/bacnet/src/fifo.c **** *
  51:../src/middleware/bacnet/src/fifo.c **** * Then declare the FIFO tracking structure:
  52:../src/middleware/bacnet/src/fifo.c **** * {@code
  53:../src/middleware/bacnet/src/fifo.c **** * static FIFO_BUFFER queue;
  54:../src/middleware/bacnet/src/fifo.c **** * }
  55:../src/middleware/bacnet/src/fifo.c **** *
  56:../src/middleware/bacnet/src/fifo.c **** * Initialize the queue with the data store:
  57:../src/middleware/bacnet/src/fifo.c **** * {@code
  58:../src/middleware/bacnet/src/fifo.c **** * FIFO_Init(&queue, data_store, sizeof(data_store));
  59:../src/middleware/bacnet/src/fifo.c **** * }
  60:../src/middleware/bacnet/src/fifo.c **** *
  61:../src/middleware/bacnet/src/fifo.c **** * Then begin to use the FIFO queue by giving it data, retreiving data,
  62:../src/middleware/bacnet/src/fifo.c **** * and checking the FIFO queue to see if it is empty or full:
  63:../src/middleware/bacnet/src/fifo.c **** * {@code
  64:../src/middleware/bacnet/src/fifo.c **** * uint8_t in_data = 0;
  65:../src/middleware/bacnet/src/fifo.c **** * uint8_t out_data = 0;
  66:../src/middleware/bacnet/src/fifo.c **** * uint8_t add_data[5] = {0};
  67:../src/middleware/bacnet/src/fifo.c **** * uint8_t pull_data[5] = {0};
  68:../src/middleware/bacnet/src/fifo.c **** * unsigned count = 0;
  69:../src/middleware/bacnet/src/fifo.c **** * bool status = false;
  70:../src/middleware/bacnet/src/fifo.c **** *
  71:../src/middleware/bacnet/src/fifo.c **** * status = FIFO_Put(&queue, in_data);
  72:../src/middleware/bacnet/src/fifo.c **** * if (!FIFO_Empty(&queue)) {
  73:../src/middleware/bacnet/src/fifo.c **** *     out_data = FIFO_Get(&queue);
  74:../src/middleware/bacnet/src/fifo.c **** * }
  75:../src/middleware/bacnet/src/fifo.c **** * if (FIFO_Available(&queue, sizeof(add_data))) {
  76:../src/middleware/bacnet/src/fifo.c **** *     status = FIFO_Add(&queue, add_data, sizeof(add_data));
  77:../src/middleware/bacnet/src/fifo.c **** * }
  78:../src/middleware/bacnet/src/fifo.c **** * count = FIFO_Count(&queue);
  79:../src/middleware/bacnet/src/fifo.c **** * if (count == sizeof(add_data)) {
  80:../src/middleware/bacnet/src/fifo.c **** *     count = FIFO_Pull(&queue, &pull_data[0], sizeof(pull_data));
  81:../src/middleware/bacnet/src/fifo.c **** * }
  82:../src/middleware/bacnet/src/fifo.c **** *
  83:../src/middleware/bacnet/src/fifo.c **** * }
  84:../src/middleware/bacnet/src/fifo.c **** *
  85:../src/middleware/bacnet/src/fifo.c **** * Normally the FIFO is used by a producer, such as in interrupt service
  86:../src/middleware/bacnet/src/fifo.c **** * routine, which places data into the queue using FIFO_Put(), and a consumer,
  87:../src/middleware/bacnet/src/fifo.c **** * such as a main loop handler, which pulls data from the queue by first
  88:../src/middleware/bacnet/src/fifo.c **** * checking the queue for data using FIFO_Empty(), and then pulling data from
  89:../src/middleware/bacnet/src/fifo.c **** * the queue using FIFO_Get().
  90:../src/middleware/bacnet/src/fifo.c **** *
  91:../src/middleware/bacnet/src/fifo.c **** */
