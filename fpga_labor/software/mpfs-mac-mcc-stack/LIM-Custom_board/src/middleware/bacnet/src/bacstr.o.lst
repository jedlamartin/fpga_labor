 234:../src/middleware/bacnet/src/bacstr.c **** /* converts an null terminated ASCII string to an bitstring.
 235:../src/middleware/bacnet/src/bacstr.c ****    Expects "1,0,1,0,1,1" or "101011" as the bits
 236:../src/middleware/bacnet/src/bacstr.c ****    returns true if successfully converted and fits; false if too long */
 237:../src/middleware/bacnet/src/bacstr.c **** bool bitstring_init_ascii(
 238:../src/middleware/bacnet/src/bacstr.c ****     BACNET_BIT_STRING * bit_string,
 239:../src/middleware/bacnet/src/bacstr.c ****     const char *ascii)
 240:../src/middleware/bacnet/src/bacstr.c **** {
 241:../src/middleware/bacnet/src/bacstr.c ****     bool status = false;        /* return value */
 242:../src/middleware/bacnet/src/bacstr.c ****     unsigned index = 0; /* offset into buffer */
 243:../src/middleware/bacnet/src/bacstr.c ****     uint8_t bit_number = 0;
 244:../src/middleware/bacnet/src/bacstr.c **** 
 245:../src/middleware/bacnet/src/bacstr.c ****     if (bit_string) {
 246:../src/middleware/bacnet/src/bacstr.c ****         bitstring_init(bit_string);
 247:../src/middleware/bacnet/src/bacstr.c ****         if (ascii[0] == 0) {
 248:../src/middleware/bacnet/src/bacstr.c ****             /* nothing to decode, so success! */
 249:../src/middleware/bacnet/src/bacstr.c ****             status = true;
 250:../src/middleware/bacnet/src/bacstr.c ****         } else {
 251:../src/middleware/bacnet/src/bacstr.c ****             while (ascii[index] != 0) {
 252:../src/middleware/bacnet/src/bacstr.c ****                 if (bit_number > bitstring_bits_capacity(bit_string)) {
 253:../src/middleware/bacnet/src/bacstr.c ****                     /* too long of a string */
 254:../src/middleware/bacnet/src/bacstr.c ****                     status = false;
 255:../src/middleware/bacnet/src/bacstr.c ****                     break;
 256:../src/middleware/bacnet/src/bacstr.c ****                 }
 257:../src/middleware/bacnet/src/bacstr.c ****                 if (ascii[index] == '1') {
 258:../src/middleware/bacnet/src/bacstr.c ****                     bitstring_set_bit(bit_string, bit_number, true);
 259:../src/middleware/bacnet/src/bacstr.c ****                     bit_number++;
 260:../src/middleware/bacnet/src/bacstr.c ****                     status = true;
 261:../src/middleware/bacnet/src/bacstr.c ****                 } else if (ascii[index] == '0') {
 262:../src/middleware/bacnet/src/bacstr.c ****                     bitstring_set_bit(bit_string, bit_number, false);
 263:../src/middleware/bacnet/src/bacstr.c ****                     bit_number++;
 264:../src/middleware/bacnet/src/bacstr.c ****                     status = true;
 265:../src/middleware/bacnet/src/bacstr.c ****                 } else {
 266:../src/middleware/bacnet/src/bacstr.c ****                     /* skip non-numeric or alpha */
 267:../src/middleware/bacnet/src/bacstr.c ****                     index++;
 268:../src/middleware/bacnet/src/bacstr.c ****                     continue;
 269:../src/middleware/bacnet/src/bacstr.c ****                 }
 270:../src/middleware/bacnet/src/bacstr.c ****                 /* next character */
 271:../src/middleware/bacnet/src/bacstr.c ****                 index++;
 272:../src/middleware/bacnet/src/bacstr.c ****             }
 273:../src/middleware/bacnet/src/bacstr.c ****         }
 274:../src/middleware/bacnet/src/bacstr.c ****     }
 275:../src/middleware/bacnet/src/bacstr.c **** 
 276:../src/middleware/bacnet/src/bacstr.c ****     return status;
 277:../src/middleware/bacnet/src/bacstr.c **** }
