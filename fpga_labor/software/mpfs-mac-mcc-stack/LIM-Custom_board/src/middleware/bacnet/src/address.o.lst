  70:../src/middleware/bacnet/src/address.c **** /* State flags for cache entries */
  71:../src/middleware/bacnet/src/address.c **** 
  72:../src/middleware/bacnet/src/address.c **** #define BAC_ADDR_IN_USE    1    /* Address cache entry in use */
  73:../src/middleware/bacnet/src/address.c **** #define BAC_ADDR_BIND_REQ  2    /* Bind request outstanding for entry */
  74:../src/middleware/bacnet/src/address.c **** #define BAC_ADDR_STATIC    4    /* Static address mapping - does not expire */
  75:../src/middleware/bacnet/src/address.c **** #define BAC_ADDR_SHORT_TTL 8    /* Oppertunistaclly added address with short TTL */
  76:../src/middleware/bacnet/src/address.c **** #define BAC_ADDR_RESERVED  128  /* Freed up but held for caller to fill */
  77:../src/middleware/bacnet/src/address.c **** 
  78:../src/middleware/bacnet/src/address.c **** #define BAC_ADDR_SECS_1HOUR 3600        /* 60x60 */
  79:../src/middleware/bacnet/src/address.c **** #define BAC_ADDR_SECS_1DAY  86400       /* 60x60x24 */
  80:../src/middleware/bacnet/src/address.c **** 
  81:../src/middleware/bacnet/src/address.c **** #define BAC_ADDR_LONG_TIME  BAC_ADDR_SECS_1DAY
  82:../src/middleware/bacnet/src/address.c **** #define BAC_ADDR_SHORT_TIME BAC_ADDR_SECS_1HOUR
  83:../src/middleware/bacnet/src/address.c **** #define BAC_ADDR_FOREVER    0xFFFFFFFF  /* Permenant entry */
