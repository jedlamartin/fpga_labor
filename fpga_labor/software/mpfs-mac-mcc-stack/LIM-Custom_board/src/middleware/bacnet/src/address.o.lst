  63:../src/middleware/bacnet/src/address.c ****     uint8_t Flags;
  64:../src/middleware/bacnet/src/address.c ****     uint32_t device_id;
  65:../src/middleware/bacnet/src/address.c ****     unsigned max_apdu;
  66:../src/middleware/bacnet/src/address.c ****     BACNET_ADDRESS address;
  67:../src/middleware/bacnet/src/address.c ****     uint32_t TimeToLive;
  68:../src/middleware/bacnet/src/address.c **** } Address_Cache[MAX_ADDRESS_CACHE];
