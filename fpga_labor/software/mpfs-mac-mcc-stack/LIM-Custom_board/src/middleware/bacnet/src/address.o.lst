  53:../src/middleware/bacnet/src/address.c **** /** @file address.c  Handle address binding */
  54:../src/middleware/bacnet/src/address.c **** 
  55:../src/middleware/bacnet/src/address.c **** /* This module is used to handle the address binding that */
  56:../src/middleware/bacnet/src/address.c **** /* occurs in BACnet.  A device id is bound to a MAC address. */
  57:../src/middleware/bacnet/src/address.c **** /* The normal method is using Who-Is, and using the data from I-Am */
  58:../src/middleware/bacnet/src/address.c **** 
