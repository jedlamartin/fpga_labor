1389:../src/middleware/bacnet/src/bacapp.c **** /* Print the extracted value from the requested BACnet object property to the
1390:../src/middleware/bacnet/src/bacapp.c ****  * specified stream. If stream is NULL, do not print anything. If extraction
1391:../src/middleware/bacnet/src/bacapp.c ****  * failed, do not print anything. Return the status of the extraction.
1392:../src/middleware/bacnet/src/bacapp.c ****  */
1393:../src/middleware/bacnet/src/bacapp.c **** bool bacapp_print_value(
1394:../src/middleware/bacnet/src/bacapp.c ****     FILE * stream,
1395:../src/middleware/bacnet/src/bacapp.c ****     BACNET_OBJECT_PROPERTY_VALUE * object_value)
1396:../src/middleware/bacnet/src/bacapp.c **** {
1397:../src/middleware/bacnet/src/bacapp.c ****     char *str;
1398:../src/middleware/bacnet/src/bacapp.c ****     bool retval = false;
1399:../src/middleware/bacnet/src/bacapp.c ****     size_t str_len = 32;
1400:../src/middleware/bacnet/src/bacapp.c ****     int status;
1401:../src/middleware/bacnet/src/bacapp.c **** 
1402:../src/middleware/bacnet/src/bacapp.c ****     while (true) {
1403:../src/middleware/bacnet/src/bacapp.c ****         /* Try to allocate memory for the output string. Give up if unable. */
1404:../src/middleware/bacnet/src/bacapp.c ****         str = (char *) calloc(sizeof(char), str_len);
1405:../src/middleware/bacnet/src/bacapp.c ****         if (!str)
1406:../src/middleware/bacnet/src/bacapp.c ****             break;
1407:../src/middleware/bacnet/src/bacapp.c **** 
1408:../src/middleware/bacnet/src/bacapp.c ****         /* Try to extract the value into allocated memory. If unable, try again */
1409:../src/middleware/bacnet/src/bacapp.c ****         /* another time with a string that is twice as large. */
1410:../src/middleware/bacnet/src/bacapp.c ****         status = bacapp_snprintf_value(str, str_len, object_value);
1411:../src/middleware/bacnet/src/bacapp.c ****         if ((status < 0) || ((size_t)status >= str_len)) {
1412:../src/middleware/bacnet/src/bacapp.c ****             free(str);
1413:../src/middleware/bacnet/src/bacapp.c ****             str_len *= 2;
1414:../src/middleware/bacnet/src/bacapp.c ****         } else if (status == 0) {
1415:../src/middleware/bacnet/src/bacapp.c ****             free(str);
1416:../src/middleware/bacnet/src/bacapp.c ****             break;
1417:../src/middleware/bacnet/src/bacapp.c ****         } else {
1418:../src/middleware/bacnet/src/bacapp.c ****             if (stream)
1419:../src/middleware/bacnet/src/bacapp.c ****                 fprintf(stream, "%s", str);
1420:../src/middleware/bacnet/src/bacapp.c ****             free(str);
1421:../src/middleware/bacnet/src/bacapp.c ****             retval = true;
1422:../src/middleware/bacnet/src/bacapp.c ****             break;
1423:../src/middleware/bacnet/src/bacapp.c ****         }
1424:../src/middleware/bacnet/src/bacapp.c ****     }
1425:../src/middleware/bacnet/src/bacapp.c ****     return retval;
1426:../src/middleware/bacnet/src/bacapp.c **** }
1427:../src/middleware/bacnet/src/bacapp.c **** #endif
