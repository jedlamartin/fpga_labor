 447:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****     /*
 448:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      * R3.1
 449:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      * PVT calibration
 450:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      * Wait for IOEN from power detectors DDR and SGMII - IO enable signal from
 451:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      * System Control powers on
 452:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      *
 453:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      * From DDR phy SAC spec:
 454:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      *      MSS processor releases dce bus to send RPC bits to IO buffer,
 455:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      *      setting each to it's programmed mode and then asserts
 456:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      *      ioen high at end of this state.
 457:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      *
 458:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      *
 459:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      *      Following verification required for MSS IO Calibration (DDRPHY,
 460:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      *      SGMII and MSSIO)
