  72:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          external clock reference
  73:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          MSS PLL, SHMII PLL, SGMII PLL, MSS Mux's
  74:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          IO settings and IO MUX
