3579:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     * 0x87654321
3580:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     * 0x56789876
3581:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     * 0x43211234
3582:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     * We should see:
3583:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *      NNNN_YXXX_XXX3_4YXX_XXXX_76YX_XXXX_X21Y_XXXX_XX78
3584:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *      N: not used
3585:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *      Y:
3586:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     */
