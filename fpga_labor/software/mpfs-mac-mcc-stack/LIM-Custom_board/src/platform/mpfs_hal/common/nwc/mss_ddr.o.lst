2395:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                     /*
2396:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * We need to be able to implement different physical
2397:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * configurations of LPDDR4, given the twindie architecture.
2398:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * These are not fully decoded by the APB decoder (we dont
2399:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * have all the options).
2400:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * Basically we want to support:
2401:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * Hook the CA buses from the 2 die up in parallel on the
2402:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * same FPGA pins
2403:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * Hook the CA buses from the 2 die up in parallel using
2404:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * the mirrored FPGA pins (IE CA_A/CA_B)
2405:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * Some combination of the 2, ie duplicate the clocks but
2406:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * not the CA, duplicate the clocks and command, but not
2407:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * address, etc.
2408:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      */
2409:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                     /* OVRT_EN_ADDCMD1 (default 0xF00), register named ovrt11 */
2410:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** #ifndef LIBERO_SETTING_RPC_EN_ADDCMD0_OVRT9
2411:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                     /*
2412:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * If this define is not present, indicates older
2413:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * Libero core (pre 2.0.109)
2414:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * So we run this code
2415:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      */
