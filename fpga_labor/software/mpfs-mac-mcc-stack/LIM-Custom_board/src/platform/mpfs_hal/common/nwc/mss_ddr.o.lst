2424:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                             0xffffffff;
2425:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                     }
2426:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
2427:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                     /* OVRT_EN_ADDCMD2 (default 0xE06U), register named ovrt12 */
