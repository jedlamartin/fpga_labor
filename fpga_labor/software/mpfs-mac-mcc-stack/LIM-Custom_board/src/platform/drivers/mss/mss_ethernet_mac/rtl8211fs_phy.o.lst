 367:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c ****     0xFFFFU /* 06 End of list... */
 368:../src/platform/drivers/mss/mss_ethernet_mac/rtl8211fs_phy.c **** };
