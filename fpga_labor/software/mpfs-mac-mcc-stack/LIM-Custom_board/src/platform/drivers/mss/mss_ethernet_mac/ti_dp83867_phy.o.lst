   4:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * SPDX-License-Identifier: MIT
   5:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  *
   6:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * @file ti_dp83867_phy.c
   7:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * @author Microchip FPGA Embedded Systems Solutions
   8:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * @brief TI DP83867ISRGZ PHY interface driver implementation for use with the
   9:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * G5 SoC Emulation Platform.
  10:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  *
  11:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  *
  12:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * This system uses the SGMII interface.
  13:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  *
  14:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * The following are the default selections from the hardware strapping:
  15:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  *
  16:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * RX_D0   - Strap option 4, PHY_ADD0 = 1, PHY_ADD1 = 1
  17:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * RX_D2   - Strap option 0, PHY_ADD2 = 0, PHY_ADD1 = 0
  18:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * RX_CTRL - Strap option 0, N/A - the following note applies:
  19:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  *           Strap modes 1 and 2 are not applicable for RX_CTRL. The RX_CTRL
  20:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  *           strap must be configured for strap mode 3 or strap mode 4. If the
  21:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  *           RX_CTRL pin cannot be strapped to mode 3 or mode 4, bit[7] of
  22:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  *           Configuration Register 4 (address 0x0031) must be cleared to 0.
  23:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * GPIO_0  - Strap option 0, RGMII Clock Skew RX[0] = 0. GPIO_0 is connected to
  24:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  *           I/O pin AR22 on the VU9P FPGA device.
  25:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * GPIO_1  - Strap option 0, RGMII Clock Skew RX[1] = 0,
  26:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  *           RGMII Clock Skew RX[2] = 0
  27:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * LED_2   - Strap option 2, RGMII Clock Skew TX[0] = 1,
  28:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  *           RGMII Clock Skew TX[1] = 0
  29:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * LED_1   - Strap option 2, RGMII Clock Skew TX[2] = 1, ANEG_SEL = 0
  30:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  * LED_0   - Strap option 2, SGMII_Enable = 1, Mirror Enable = 0
  31:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  *
  32:../src/platform/drivers/mss/mss_ethernet_mac/ti_dp83867_phy.c ****  */
