 325:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****             g_my_mac,
 326:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****             (uint8_t)(phy_port + g_my_mac->phy_addr),
 327:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****             (uint8_t)phy_reg); /* TBD: PMCS Warning only works for single MAC/VSC8575 combination *
 328:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****     }
