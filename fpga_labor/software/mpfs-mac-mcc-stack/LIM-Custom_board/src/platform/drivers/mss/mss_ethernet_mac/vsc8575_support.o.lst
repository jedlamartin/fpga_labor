 297:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c **** static vtss_rc viper_phy_post_reset(void)
 298:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c **** {
 299:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****     return (vtss_phy_post_reset (NULL, 0));
