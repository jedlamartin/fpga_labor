 222:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c **** vtss_callout_unlock(const vtss_api_lock_t *const lock)
 223:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c **** {
 224:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****     (void)lock;
 225:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c **** }
 226:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c **** 
 227:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c **** /**
 228:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****  * brief SPI read/write function
 229:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****  *
 230:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****  * param inst [IN] Vitesse API instance.
 231:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****  * param port_no [IN] Port number.
 232:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****  * param bitsize [IN] Size (in bytes) of bitstream following this parameter.
 233:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****  * param data [IN|OUT] Pointer to the data to be written to SPI Slave, if doing write operation.
 234:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****  *                      Pointer to the data read from SPI Slave, if doing read operation.
 235:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****  *
 236:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****  * return Return code.
 237:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****  **/
 238:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c **** /* G5 SOC Emulation platform has no SPI interface at the moment... */
 239:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c **** #ifdef _ZL303XX_FMC_BOARD
 240:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c **** 
 241:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c **** vtss_rc spi_read_write(const vtss_inst_t inst,
 242:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****                        const vtss_port_no_t port_no,
 243:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****                        const u8 bitsize,
 244:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****                        u8 *const bitstream);
 245:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c **** vtss_rc
 246:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c **** spi_read_write(const vtss_inst_t inst,
 247:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****                const vtss_port_no_t port_no,
 248:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****                const u8 bitsize,
 249:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****                u8 *const bitstream)
 250:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c **** {
 251:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****     (void)inst;
 252:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****     (void)port_no;
 253:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****     /*
 254:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****      * The VTSS API transfers 32 bit values using this function.
 255:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****      *
 256:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****      * We use the bitsize parameter to determine read vs write as
 257:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****      * it will be 7 for writes and 10 for reads.
 258:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****      *
 259:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****      * The first 3 bytes are the R/W status and the register address
 260:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****      * information.
 261:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****      *
 262:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****      * When writing, the next 4 values are the frame to write,
 263:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****      * When reading, the next 3 values are padding and the last 4
 264:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****      * bytes are the read data.
 265:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****      */
 266:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****     if (7 == bitsize) /* Write operation */
 267:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****     {
 268:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****         SPI_transfer_block_vsc(&g_vsc_spi, bitstream, bitsize, 0, 0);
 269:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****     }
 270:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****     else
 271:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****     {
 272:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****         SPI_transfer_block_vsc(&g_vsc_spi, bitstream, 6, &bitstream[6], 4);
 273:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****     }
 274:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****     return VTSS_RC_OK;
 275:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c **** }
 276:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c **** #endif /* _ZL303XX_FMC_BOARD */
