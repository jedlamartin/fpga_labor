 194:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c **** {
 195:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c **** #ifdef _ZL303XX_FMC_BOARD
 196:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****     /* 0x30200000U is the base address of the CoreSPI in the fabric */
 197:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****     SPI_init(&g_vsc_spi, 0x30200000U, 32); /* Now is probably a good time to take care of this... *
 198:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****     /*
 199:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****      * Note: for the FMC board, the APB clock frequency is 83MHz and the maximum
 200:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****      * allowed clock frequency for the 1588 SPI interface is 25MHz. We can only choose
 201:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****      * even clock divisors and a divisor of 4 used in the design gives us a 20.75MHz SPI clock.
 202:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****      */
 203:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****     SPI_configure_master_mode(&g_vsc_spi); /* Motorola Mode 0, 8 bits selected in design */
 204:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****     SPI_set_slave_select(&g_vsc_spi, SPI_SLAVE_0);
 205:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c **** 
 206:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****     target->spi_read_write =
 207:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****         spi_read_write; /* Set pointer to SPI interface r/w function for this board */
 208:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c **** #endif
 209:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c **** 
 210:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****     target->miim_read = miim_read; /* Set pointer to the MIIM read function for this board. */
 211:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****     target->miim_write = miim_write; /* Set pointer to the MIIM write function for this board. */
 212:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c ****     return 0;
 213:../src/platform/drivers/mss/mss_ethernet_mac/vsc8575_support.c **** }
