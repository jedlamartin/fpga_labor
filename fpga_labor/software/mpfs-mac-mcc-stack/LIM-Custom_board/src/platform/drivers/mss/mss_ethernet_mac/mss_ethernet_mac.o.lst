2472:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     PLIC_DisableIRQ(this_mac->mac_q_int[0]); /* Single interrupt from GEM? */
2473:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c **** 
2474:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     /*
2475:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * Wait for pending transmits to complete as you cannot alter
2476:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * tx queue pointers while transmit is active...
2477:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      */
2478:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     while (0 != (*p_tx_status & GEM_TRANSMIT_GO))
2479:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     {
2480:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****         delay++; /* Empty loop will cause debug issues... */
2481:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     }
