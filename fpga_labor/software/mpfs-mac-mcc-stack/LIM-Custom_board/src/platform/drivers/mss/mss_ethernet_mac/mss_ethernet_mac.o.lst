1797:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     /*
1798:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * Simplified transmit operation which depends on the following assumptions:
1799:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      *
1800:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * 1. The TX DMA buffer size is big enough to contain a full packet.
1801:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * 2. We will only transmit one packet at a time.
1802:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * 3. We wait for any outstanding transmits on other queues to complete
1803:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      *    because we need to ALWAYS write to the queue 0 pointer to trigger
1804:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      *    internal restart of the DMA process.
1805:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      *
1806:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * We do transmission by using two buffer descriptors. The first contains the
1807:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * packet to transmit and the second is a dummy one with the USED bit set. This
1808:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * halts transmission once the first packet is transmitted. We always reset the
1809:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * TX DMA to point to the first packet when we send a packet so we don't have
1810:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * to juggle buffer positions or worry about wrap.
1811:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      */
1812:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     uint32_t tx_length = length;
