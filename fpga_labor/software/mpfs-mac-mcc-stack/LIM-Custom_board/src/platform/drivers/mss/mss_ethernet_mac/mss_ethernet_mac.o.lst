2418:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c **** 
2419:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c **** void
2420:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c **** copy8b(uint64_t *dest, uint64_t *source, uint32_t count)
2421:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c **** {
2422:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     while (count--)
