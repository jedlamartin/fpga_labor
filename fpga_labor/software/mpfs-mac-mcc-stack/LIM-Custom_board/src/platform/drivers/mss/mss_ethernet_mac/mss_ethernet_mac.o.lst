2494:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     this_mac->queue[0].nb_available_tx_desc = 1;
2495:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     this_mac->queue[0].current_tx_desc = 0;
2496:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     *this_mac->queue[0].transmit_q_ptr = (uint32_t)((uint64_t)&this_mac->queue[0].tx_desc_tab[0]);
2497:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     *p_nw_control = *p_nw_control | GEM_TRANSMIT_START;
2498:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c **** 
2499:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     PLIC_EnableIRQ(this_mac->mac_q_int[0]); /* Single interrupt from GEM? */
