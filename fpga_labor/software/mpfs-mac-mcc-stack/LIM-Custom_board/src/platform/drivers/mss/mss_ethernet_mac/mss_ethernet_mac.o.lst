2033:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     /*
2034:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * Multi packet, multi queue transmit operation which depends on the
2035:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * following assumptions:
2036:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      *
2037:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * 1. queue_mask indicates the queues which may be involved so that we can
2038:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      *    properly handle ISR vs normal calling.
2039:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      *    Set the mask to 0x0000000F to indicate all queues if there is any
2040:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      *    uncertainty.
2041:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      *    Set the mask to 0xFFFFFFF0 to indicate we are being called from a GEM
2042:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      *    ISR.
2043:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * 2. We wait for any outstanding transmits on other queues to complete
2044:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      *    because we need to ALWAYS write to the queue 0 pointer to trigger
2045:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      *    internal restart of the DMA process.
2046:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * 3. We accept at most MSS_MAC_TX_RING_SIZE-1 packets as the final packet
2047:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      *    in the chain is a dummy one to get the TX DMA engine to stop. Any
2048:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      *    packets beyond that are silently dropped.
2049:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      *
2050:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * We do transmission by using multiple buffer descriptors. The initial
2051:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * descriptors are for the packet(s) to transmit and the last is a dummy one
2052:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * with the USED bit set. This halts transmission once the first packet is
2053:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * transmitted. We always reset the TX DMA to point to the first packet when
2054:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * we send packets so we don't have to juggle buffer positions or worry
2055:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * about wrap.
2056:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      */
2057:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     uint32_t mask_bit;
