2484:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     this_mac->queue[0].tries = 0UL;
2485:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c **** 
2486:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     /* All is quiet now so let's construct the TX queue(s) */
2487:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c **** 
2488:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     copy8b((uint64_t *)this_mac->queue[0].tx_desc_tab,
2489:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****            (uint64_t *)descriptors,
