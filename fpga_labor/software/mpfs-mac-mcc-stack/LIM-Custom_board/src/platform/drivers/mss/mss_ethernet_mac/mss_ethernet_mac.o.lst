2424:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c **** }
2425:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c **** 
2426:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c **** int32_t
2427:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c **** MSS_MAC_send_pkts_fast(mss_mac_instance_t *this_mac,
2428:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****                        mss_mac_tx_desc_t *descriptors,
2429:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****                        uint32_t tx_count)
2430:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c **** {
2431:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     /*
2432:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * Multi packet, multi queue transmit operation which depends on the
2433:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * following assumptions:
2434:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      *
2435:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * 1. queue_mask indicates the queues which may be involved so that we can
2436:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      *    properly handle ISR vs normal calling.
2437:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      *    Set the mask to 0x0000000F to indicate all queues if there is any
2438:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      *    uncertainty.
2439:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      *    Set the mask to 0xFFFFFFF0 to indicate we are being called from a GEM
2440:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      *    ISR.
2441:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * 2. We wait for any outstanding transmits on other queues to complete
2442:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      *    because we need to ALWAYS write to the queue 0 pointer to trigger
2443:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      *    internal restart of the DMA process.
2444:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * 3. We accept at most MSS_MAC_TX_RING_SIZE-1 packets as the final packet
2445:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      *    in the chain is a dummy one to get the TX DMA engine to stop. Any
2446:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      *    packets beyond that are silently dropped.
2447:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      *
2448:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * We do transmission by using multiple buffer descriptors. The initial
2449:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * descriptors are for the packet(s) to transmit and the last is a dummy one
2450:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * with the USED bit set. This halts transmission once the first packet is
2451:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * transmitted. We always reset the TX DMA to point to the first packet when
2452:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * we send packets so we don't have to juggle buffer positions or worry
2453:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      * about wrap.
2454:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****      */
2455:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     volatile int delay = 0;
2456:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     volatile uint32_t *p_nw_control;
2457:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     volatile uint32_t *p_tx_status;
2458:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c **** 
2459:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     p_nw_control = &this_mac->mac_base->NETWORK_CONTROL;
2460:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     p_tx_status = &this_mac->mac_base->TRANSMIT_STATUS;
2461:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c **** 
2462:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     /* Wait for queue to empty */
2463:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     while (this_mac->queue[0].nb_available_tx_desc != (uint32_t)MSS_MAC_TX_RING_SIZE)
2464:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     {
2465:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****         /* Make sure transmit stays enabled */
2466:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****         if (0 == (*p_nw_control & GEM_ENABLE_TRANSMIT))
2467:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****         {
2468:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****             *p_nw_control = *p_nw_control | GEM_ENABLE_TRANSMIT;
2469:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****         }
2470:../src/platform/drivers/mss/mss_ethernet_mac/mss_ethernet_mac.c ****     }
