  46:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** /* This variable tracks if the UART peripheral is located on S5 or S6 on AXI
  47:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****  * switch. This will be used to determine which UART instance to be passed to
  48:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****  * UART interrupt handler. value 0 = S5(low). value 1 = S6(high)
  49:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****  * Bit positions:
  50:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****  * 0 ==> MMUART0
  51:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****  * 1 ==> MMUART1
  52:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****  * 2 ==> MMUART2
  53:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****  * 3 ==> MMUART3
  54:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****  * 4 ==> MMUART4
  55:../src/platform/drivers/mss/mss_mmuart/mss_uart.c **** 
  56:../src/platform/drivers/mss/mss_mmuart/mss_uart.c ****  */
