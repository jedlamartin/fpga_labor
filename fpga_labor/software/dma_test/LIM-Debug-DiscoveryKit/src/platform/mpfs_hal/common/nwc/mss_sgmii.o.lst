 442:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****     /*
 443:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      * R3.1
 444:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      * PVT calibration
 445:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      * Wait for IOEN from power detectors DDR and SGMII - IO enable signal from
 446:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      * System Control powers on
 447:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      *
 448:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      *      MSS processor releases dce bus to send RPC bits to IO buffer,
 449:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      *      setting each to it's programmed mode and then asserts
 450:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      *      ioen high at end of this state.
 451:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      *
 452:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      *
 453:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      *      Following verification required for MSS IO Calibration (DDRPHY,
 454:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      *      SGMII and MSSIO)
 455:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      *          Auto-calibration supply ramp time settings
 456:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      *          Calibration in reset until ioen_bnk goes high, timer complete
 457:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      *          and setup of bits complete
 458:../src/platform/mpfs_hal/common/nwc/mss_sgmii.c ****      *              scbclk divider setting (/1)
