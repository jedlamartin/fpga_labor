 172:../src/platform/mpfs_hal/common/nwc/mss_io.c **** /***************************************************************************//**
 173:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *    MSSIO OFF Mode
 174:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *
 175:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *    The following settings are applied if MMSIO unused/off
 176:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *
 177:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *      The IO Buffers are disabled.
 178:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *      Output drivers are disabled (set the drv<3:0> bits to 0000, output
 179:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *      enable "mss_oe" bit to 0)
 180:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *      Disable the WPU bit set to 0 and enable the WPD bit set to 1.
 181:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *      Receivers are disabled. (Ibufmd<2:0> set to 7)
 182:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *
 183:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *      MSS can enable OFF mode through configurator bit for selective MSSIO
 184:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *      from Bank2/Bank4 by making drv<3:0>/mss_oe bit to "0" for that
 185:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *      particular MSSIO making Output driver disabled and ibufmd <2:0>  bit to
 186:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *      "7" for that particular MSSIO making input receiver disabled.
 187:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *
 188:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  */
 189:../src/platform/mpfs_hal/common/nwc/mss_io.c **** 
 190:../src/platform/mpfs_hal/common/nwc/mss_io.c **** /***************************************************************************//**
