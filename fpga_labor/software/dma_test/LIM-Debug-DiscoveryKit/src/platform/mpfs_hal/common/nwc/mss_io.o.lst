 194:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *
 195:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  * To setup bank 2 and 4, ncode and pcode scb registers in system
 196:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  * register block are set as per Libero supplied values.
 197:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  * These need to be transferred to I/0
 198:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  *
 199:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  * @return 0 => pass
 200:../src/platform/mpfs_hal/common/nwc/mss_io.c ****  */
