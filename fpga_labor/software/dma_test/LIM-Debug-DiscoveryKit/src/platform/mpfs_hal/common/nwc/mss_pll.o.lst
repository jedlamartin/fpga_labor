 244:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * Change the MSS clock as required.
 245:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     *
 246:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * CLOCK_CONFIG_CR
 247:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * [5:0]
 248:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * Sets the master synchronous clock divider
 249:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * bits [1:0] CPU clock divider
 250:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * bits [3:2] AXI clock divider
 251:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * bits [5:4] AHB/APB clock divider
 252:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * 00=/1 01=/2 10=/4 11=/8 (AHB/APB divider may not be set to /1)
 253:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * Reset = 0x3F
 254:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     *
 255:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * SYSREG->CLOCK_CONFIG_CR = (0x0U<<0U) | (0x1U<<2U) | (0x2U<<4U);
 256:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * MSS clk= 80Mhz, implies CPU = 80Mhz, AXI = 40Mhz, AHB/APB = 20Mhz
 257:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * Until we switch in MSS PLL clock (MSS_SCB_CFM_MSS_MUX->MSSCLKMUX = 0x01)
 258:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * e.g. If MSS clk 800Mhz
 259:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****     * MSS clk= 800Mhz, implies CPU = 800Mhz, AXI = 400Mhz, AHB/APB = 200Mhz
 260:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****    */
