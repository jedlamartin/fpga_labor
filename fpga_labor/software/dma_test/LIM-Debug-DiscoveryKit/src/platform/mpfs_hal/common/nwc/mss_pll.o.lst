 110:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  e.g.
 111:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *  PLL_CKMUX = 0x00000154
 112:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *    pll0_rfclk0_sel = 1 => refclk_p is used for pll0 ref0 and refclk_n is
 113:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      *    fed to MSS PLL ref1
 114:../src/platform/mpfs_hal/common/nwc/mss_pll.c ****      */
