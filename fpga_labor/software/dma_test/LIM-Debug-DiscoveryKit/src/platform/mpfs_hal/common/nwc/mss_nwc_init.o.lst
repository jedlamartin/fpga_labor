  67:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          external clock reference
  68:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          MSS PLL, SHMII PLL, SGMII PLL, MSS Mux's
  69:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          IO settings and IO MUX
  70:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          HSIO IO calibration options
