  74:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          MPU setup
  75:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          PMP setup
  76:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          ABP Peripheral address setup (High/Low)
  77:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *
  78:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      */
