 151:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c **** 
 152:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****     /*
 153:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *
 154:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *  In this step we enter Dynamic Enable mode.
 155:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *  This is done by using the following sequence:
 156:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *
 157:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *  Please note all dynamic enables must be enabled.
 158:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *  If dynamic enables are not enabled, when flash valid is asserted, value
 159:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *  of SCB registers will be immediately written to with default values
 160:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *  rather than the RPC values.
 161:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *
 162:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *  Dynamic Enable mode:
 163:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      Step 1:
 164:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          Make sure SCB dynamic enable bit is high
 165:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      step 2: Assert MSS core_up
 166:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          followed by delay
 167:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      step 3: Change dce[0,1,2] to 0x00
 168:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          followed by delay
 169:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      step 4: Assert flash valid
 170:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          followed by delay
 171:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      step 5: make sure all RPC registers are set to desired values
 172:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *              (using mode and direct RPC writes to RPC)
 173:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      step 6: soft reset IP so SCB registers are written with RPC values.
 174:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          note: We will carry out step 5/6 later, once we have modified any
 175:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          RPC registers directly that may need tweaking or are not
 176:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          included in the mode write state machine, carried out in a
 177:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          previous step.
 178:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *
 179:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          Note 1: The SCB bus can be used to update/write new values to
 180:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          the SCB registers through the SCB bus interface while in Dynamic
 181:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          enable mode
 182:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          Note 2: The MSS top block assertion of core_up and flash_valid
 183:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          have no effect in themselves if MSS custom SCB register values
 184:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          if the custom SCB slaves are not being reset at the same time.
 185:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          If the custom SCB slaves are reset whilst core_up and
 186:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          flash_valid are high, then the SCB registers get asynchronously
 187:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          loaded with the values of their corresponding RPC bits. These
 188:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          values remain even after negation of reset but may be
 189:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          subsequently overwritten by SCB writes.
 190:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *
 191:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *  reg MSS_LOW_POWER_CR
 192:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *
 193:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      bit 12 flash_valid          Sets the value driven out on
 194:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *                                  mss_flash_valid_out
 195:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      bit 11 core_up              Sets the value driven out on
 196:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *                                  mss_core_up_out
 197:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      bit 10:8  dce   S           Sets the value driven out on mss_dce_out
 198:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *                                  unless G5C asserts its overrides
 199:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      bit 7 lp_stop_clocks_in     Read back of lp_stop_clocks input
 200:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      bit 6 lp_stop_clocks_out    Direct control of MSS Corner LP state
 201:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *                                  control
 202:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      bit 5 p_pll_locked          Direct control of MSS Corner
 203:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *                                  LP state control
 204:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      bit 4 lp_state_bypass       Direct control of MSS Corner LP
 205:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *                                  state control
 206:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      bit 3 lp_state_persist
 207:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      bit 2 lp_state_op
 208:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      bit 1 lp_state_ip
 209:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      bit 0 lp_state_mss
 210:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *
 211:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      In order to re-flash/update the APB RPC register values into the
 212:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      registers of a specific SCB slave,the following sequence must be
 213:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      followed:
 214:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      1)  Embedded software running on E51 must force the mss_core_up and
 215:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          mss_flash valid must be high
 216:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      2)  Then do a soft reset of the specific SCB slave that will be
 217:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          re-flashed/updated.
 218:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *
 219:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      The APB RPC registers are used in the following ways to configure
 220:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      the MSS periphery
 221:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      1)  Load values to SCB registers.
 222:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          core_up" and "flash_valid" determines if the SCB registers get
 223:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          either:
 224:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *               a.  Reset to their hardware default
 225:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *                   (when core_up/flash_valis low)
 226:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *              b.  Loaded with the APB RPC register.
 227:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *                   (when core_up/flash_valid high)
 228:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      2)  IO configuration settings
 229:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          These are fed directly to the static configuration of IOA cells
 230:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          within the IOG lanes of the DDR and SGMII PHYs, as long as
 231:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          "core_up" and "flash_valid" are high.
 232:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          a.  To avoid unwanted/intermediate states on IOs, the "core_up"
 233:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          and "flash_valid" should be initially 0 on MSS reset. This will
 234:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          select the safe hardware defaults. The RPC registers are written
 235:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          in the background and then simultaneously "flashed" as the new
 236:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          IO configuration by assertion of "core_up" and "flash_valid"
 237:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          being asserted.
 238:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      3)  Training IP settings
 239:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          These allow the direct control of the training IP via the APB
 240:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *          registers.
 241:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *
 242:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      Notes:
 243:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      1)  When the MSS is reset, the SCB slaves won't take on the RPC
 244:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      values. They will be reset to their hardware default values.
 245:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *
 246:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      2)  Although RPC registers are writable in APB space,
 247:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      they only take effect on the SCB registers whenever there is a
 248:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      "virtual re-flash" operation, which involves performing
 249:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      a soft reset of an SCB slave (i.e. writing to the NV_MAP register
 250:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      bit in the SOFT_RESET register in the SCB slave).
 251:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      This mechanism would only be used if a full new configuration is to
 252:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      be applied to the full SCB slave and wouldn't be used, for example
 253:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      to change just a clock mux configuration.
 254:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *
 255:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      3)  To make configuration changes to individual registers, without
 256:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      "re-flashing" all registers in an MSS custom SCB slave, it is
 257:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      necessary to write directly to the SCB registers (via SCB space) in
 258:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *      that slave, rather than writing RPC registers via APB space
 259:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      *
 260:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****      */
 261:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c **** 
 262:../src/platform/mpfs_hal/common/nwc/mss_nwc_init.c ****     /*
