2790:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /**
2791:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****   Info on OFF modes:
2792:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
2793:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****   OFF MODE from reset- I/O not being used
2794:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         MSSIO from reset- non default values
2795:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             Needs non default values to completely go completely OFF
2796:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             Drive bits and ibuff mode
2797:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         DDR - by default put to DDR4 mode so needs active intervention
2798:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             Bills sac spec (DDR PHY SAC spec section 6.1)
2799:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             Mode register set to 7
2800:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             Ibuff mode set to 7 (rx turned off)
2801:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             P-Code/ N-code of no relevance as not used
2802:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             Disable DDR PLL
2803:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                Will be off from reset- no need
2804:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             Need to reflash
2805:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****             DDR APB ( three resets - soft reset bit 0 to 1)
2806:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                 Drive odt etc
2807:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****        SGMII - from reset nothing to be done
2808:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****            See Jeff's spread sheet- default values listed
2809:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****            Extn clock off also defined in spread sheet
2810:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  */
2811:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
2812:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
2813:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /**
2814:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  ddr_off_mode(void)
2815:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  Assumed in Dynamic mode.
2816:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  i.e.
2817:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  SCB dynamic enable bit is high
2818:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  MSS core_up = 1
2819:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  dce[0,1,2] 0,0,0
2820:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  flash valid = 1
2821:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  IP:
2822:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  DECODER_DRIVER, ODT, IO all out of reset
2823:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *
2824:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  DDR PHY off mode procedure.
2825:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  1.  DDR PHY OFF mode (not used at all).
2826:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  1.  Set the DDR_MODE register to 7
2827:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  This will disable all the drive and ODT to 0, as well as set all WPU bits.
2828:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  2.  Set the RPC_IBUF_MD_* registers to 7
2829:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  This will disable all receivers.
2830:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  3.  Set the REG_POWERDOWN_B register to 0
2831:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *  This will disable the DDR PLL
2832:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  *
2833:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****  */
2834:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** static void ddr_off_mode(void)
