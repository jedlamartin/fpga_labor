3682:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         }
3683:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
3684:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     }
3685:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
3686:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     if(calib_data.mem_vref.upper != MEM_VREF_INVALID) /* we found lower/upper */
3687:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     {
