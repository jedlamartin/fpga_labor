2660:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * Libero core (pre 2.0.109)
2661:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * So we run this code
2662:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      */
