  32:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /* Version     |  Comment                                                     */
  33:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /* 0.4.031     |  Minor change to correct definition of MTC size define       */
  34:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /* 0.4.030     |  Minor cleanup- removed unused code, renamed function        */
  35:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /* 0.4.029     |  Fixed bug relating to DDR x 16 with ECC on. ECC lane 4 is   */
  36:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /*             |  now calibrated                                              */
  37:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /* 0.4.028     |  Added enable to allow unused pins PU and PD to be set for   */
  38:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /*             |  all varients. Currently only set for LPDDR4                 */
  39:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /* 0.4.027     |  Added extra debug version info at the start of DDR debug    */
  40:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /* 0.4.026     |  Added power features                                        */
  41:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /* 0.4.025     |  Corrected cache flush funtion so upper address range        */
  42:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /*             |  (0x10_xxxx_xxxx) is now included in the flush.              */
  43:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /* 0.4.024     |  Self-refresh is disabled from UI, api functions added for   */
  44:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /*             |  turning self-refresh off and on.                            */
  45:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /* 0.4.023     |  Changed default ADDCMD CLK push order for DDR4 to 0,45,90   */
  46:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /* 0.4.022     |  Tidied comments and simulation reference- no code change    */
  47:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** /* 0.4.021     |  Added options to increase post training tests during        */
