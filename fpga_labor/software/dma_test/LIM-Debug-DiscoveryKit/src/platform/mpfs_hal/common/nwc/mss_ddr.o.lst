3829:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     * 0x56789876
3830:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     * 0x43211234
3831:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     * We should see:
3832:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *      NNNN_YXXX_XXX3_4YXX_XXXX_76YX_XXXX_X21Y_XXXX_XX78
3833:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *      N: not used
3834:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *      Y:
