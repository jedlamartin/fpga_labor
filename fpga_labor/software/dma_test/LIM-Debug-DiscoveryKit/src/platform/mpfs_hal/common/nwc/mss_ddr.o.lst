3660:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         result = MTC_test(1U<<laneToTest, start_address, size);
3661:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         /* Read twice, two different patterns will be used */
3662:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         result = MTC_test(1U<<laneToTest, start_address, size);
3663:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         result |= MTC_test(1U<<laneToTest, start_address, size);
3664:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         if((result == 0U)&&(calib_data.mem_vref.lower == MEM_VREF_INVALID))
3665:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         {
