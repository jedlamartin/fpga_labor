2642:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                     /*
2643:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * We need to be able to implement different physical
2644:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * configurations of LPDDR4, given the twindie architecture.
2645:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * These are not fully decoded by the APB decoder (we dont
2646:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * have all the options).
2647:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * Basically we want to support:
2648:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * Hook the CA buses from the 2 die up in parallel on the
2649:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * same FPGA pins
2650:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * Hook the CA buses from the 2 die up in parallel using
2651:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * the mirrored FPGA pins (IE CA_A/CA_B)
2652:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * Some combination of the 2, ie duplicate the clocks but
2653:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * not the CA, duplicate the clocks and command, but not
2654:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      * address, etc.
2655:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                      */
2656:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                     /* OVRT_EN_ADDCMD1 (default 0xF00), register named ovrt11 */
