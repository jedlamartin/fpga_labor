3678:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         }
3679:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         else
3680:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         {
