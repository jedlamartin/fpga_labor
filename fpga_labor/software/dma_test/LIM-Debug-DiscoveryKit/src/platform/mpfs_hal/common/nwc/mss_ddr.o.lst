3482:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     * Train FPGA VREF using the vrgen_h and vrgen_v registers
3483:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     */
3484:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     {
3485:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     /*
3486:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      * To manipulate the FPGA VREF value, firmware must write to the
3487:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      * DPC_BITS register, located at physical address 0x2000 7184.
3488:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      * Full documentation for this register can be found in
3489:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      * DFICFG Register Map [4].
3490:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      */
3491:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     /*
3492:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      * See DPC_BITS definition in .h file
3493:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      */
3494:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     /* CFG_DDR_SGMII_PHY->DPC_BITS.bitfield.dpc_vrgen_h; */
3495:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     /* CFG_DDR_SGMII_PHY->DPC_BITS.bitfield.dpc_vrgen_v; */
3496:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
3497:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     }
3498:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
3499:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     /*
3500:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     * training carried out here- sweeping write calibration offset from 0 to F
3501:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     * Explanation: A register, expert_wrcalib, is described in MSS DDR TIP
3502:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     * Register Map [1], and its purpose is to delay--by X number of memory
3503:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     * clock cycles--the write data, write data mask, and write output enable
3504:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     * with the respect to the address and command for each lane.
3505:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     */
