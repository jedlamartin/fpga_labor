 278:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     /*
 279:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      * Turn on user setting for self refresh
 280:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      * Self-refresh control. Causes the controller to put the selected SDRAM
 281:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      * rank(chip select) into self-refresh mode at the next refresh event. Each
 282:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      * bit in init self refresh corresponds to the selected rank; asserting init
 283:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      * self refresh[0] puts the devices connected to cs n[0] into self refresh,
 284:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      * init self refresh[1] for cs n[1] and so on.
 285:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      */
 286:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     if ((LIBERO_SETTING_DDRPHY_MODE & DDRPHY_MODE_RANK_MASK) ==
 287:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                                                           DDRPHY_MODE_TWO_RANKS)
 288:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     {
 289:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         chip_selects = 3U;
