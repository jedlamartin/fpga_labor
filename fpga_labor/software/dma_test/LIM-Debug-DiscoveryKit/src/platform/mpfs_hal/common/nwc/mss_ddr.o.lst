2669:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
2670:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                         CFG_DDR_SGMII_PHY->rpc237.rpc237 =\
2671:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                             0xffffffff;
2672:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****                     }
2673:../src/platform/mpfs_hal/common/nwc/mss_ddr.c **** 
