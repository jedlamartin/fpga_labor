3675:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         else if(calib_data.mem_vref.upper != MEM_VREF_INVALID)
3676:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****         {
