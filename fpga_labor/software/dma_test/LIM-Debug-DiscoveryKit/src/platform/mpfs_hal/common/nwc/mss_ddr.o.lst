3803:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *    all error bits but the ones for the current DQ lane
3804:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *    WHILE timeout counter is less than a threshold
3805:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *        perform memory test by writing MT_EN or MT_EN_SINGLE
3806:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *        wait for memory test completion by polling MT_DONE_ACK
3807:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *        read back memory test error status from MT_ERROR_STS
3808:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *       IF no error detected
3809:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *          exit loop
3810:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *        ELSE
3811:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *          increment write calibration offset for current DQ lane
3812:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *          by writing EXPERT_WRCALIB
3813:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *    ENDWHILE
3814:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     *  ENDFOR
