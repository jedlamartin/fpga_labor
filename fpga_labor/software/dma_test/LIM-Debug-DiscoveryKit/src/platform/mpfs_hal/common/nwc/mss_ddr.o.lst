2836:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****     /*
2837:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * DDR PLL is not turn on on reset- so no need to do anything
2838:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       */
2839:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      /*
2840:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * set the mode register to 7 => off mode
2841:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * From the DDRPHY training firmware spec.:
2842:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * If the DDR interface is unused, the firmware will have to write 3'b111
2843:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * into the APB_DDR_MODE register. This will disable all the DRIVERs, ODT
2844:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * and INPUT  receivers.
2845:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * By default, WPD will be applied to all pads.
2846:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       *
2847:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * If a user wants to apply WPU, this will have to be applied through
2848:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * firmware, by changing all RPC_WPU_*=0, and RPC_WPD_*=1, via APB register
2849:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * writes.
2850:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       *
2851:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * Unused IO within an interface will automatically be shut off, as unused
2852:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * DQ/DM/DQS/and CA buffers and odt are automatically disabled by the
2853:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * decode, and put into WPD mode.
2854:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * Again, if the user wants to change this to WPU, the will have to write
2855:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       * RPC_WPU_*=0 and RPC_WPD_*=1 to override the default.
2856:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       *
2857:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****       */
2858:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      /* Note: DMI_DBI [8:1]   needs to be 0 (off) during training */
2859:../src/platform/mpfs_hal/common/nwc/mss_ddr.c ****      CFG_DDR_SGMII_PHY->DDRPHY_MODE.DDRPHY_MODE  =\
 5087              		.loc 2 2859 23
