 172:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****         reg_pointer++;
 173:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****         no_of_regs--;
 174:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****     }
 175:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c **** #endif
