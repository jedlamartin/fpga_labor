 165:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****         uint32_t no_of_regs)
 166:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c **** {
 167:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c **** #ifdef DEBUG_DDR_INIT
 168:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****     while(no_of_regs > 0U)
 169:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****     {
