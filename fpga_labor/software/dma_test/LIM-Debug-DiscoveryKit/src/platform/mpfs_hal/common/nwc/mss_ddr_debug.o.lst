 178:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c **** /**
 179:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****  * hex_num_to_decimal_string()
 180:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****  *
 181:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****  * @param value
 182:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****  * @param string
 183:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****  */
 184:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c **** void hex_num_to_decimal_string(uint32_t value, uint8_t *string)
 185:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c **** {
 186:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****     uint8_t index = 0U;
 187:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****     uint8_t index_temp = 0U;
 188:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****     uint8_t temp_string[12];
 189:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****     while(value > 0)
 190:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****     {
 191:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****         temp_string[index] = (value % 10U) + 0x30U;
 192:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****         value /= 10U;
 193:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****         index++;
 194:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****     }
 195:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****     /* reverse */
 196:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****     while(index > 0)
 197:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****     {
 198:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****         string[index_temp++] = temp_string[--index];
 199:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****     }
 200:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c ****     string[index_temp] = 0U;
 201:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c **** }
 202:../src/platform/mpfs_hal/common/nwc/mss_ddr_debug.c **** 
