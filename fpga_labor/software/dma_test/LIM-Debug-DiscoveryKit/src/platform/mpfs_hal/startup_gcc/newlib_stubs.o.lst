  19:../src/platform/mpfs_hal/startup_gcc/newlib_stubs.c **** /*==============================================================================
  20:../src/platform/mpfs_hal/startup_gcc/newlib_stubs.c ****  * Redirection of standard output to an MSS UART.
  21:../src/platform/mpfs_hal/startup_gcc/newlib_stubs.c ****  *------------------------------------------------------------------------------
  22:../src/platform/mpfs_hal/startup_gcc/newlib_stubs.c ****  * A default implementation for the redirection of the output of printf() to a
  23:../src/platform/mpfs_hal/startup_gcc/newlib_stubs.c ****  * UART is provided at the bottom of this file. This redirection is enabled by
  24:../src/platform/mpfs_hal/startup_gcc/newlib_stubs.c ****  * adding one of the following defines to your project in the project file
  25:../src/platform/mpfs_hal/startup_gcc/newlib_stubs.c ****  * boards/your-board/mpfs_hal_config/mss_sw_config.h
  26:../src/platform/mpfs_hal/startup_gcc/newlib_stubs.c ****  *
  27:../src/platform/mpfs_hal/startup_gcc/newlib_stubs.c ****  * #define MICROCHIP_STDIO_THRU_MMUARTX &g_mss_uart0_lo
  28:../src/platform/mpfs_hal/startup_gcc/newlib_stubs.c ****  * #define MICROCHIP_STDIO_THRU_MMUARTX &g_mss_uart1_lo
  29:../src/platform/mpfs_hal/startup_gcc/newlib_stubs.c ****  * #define MICROCHIP_STDIO_THRU_MMUARTX &g_mss_uart2_lo
  30:../src/platform/mpfs_hal/startup_gcc/newlib_stubs.c ****  * #define MICROCHIP_STDIO_THRU_MMUARTX &g_mss_uart3_lo
  31:../src/platform/mpfs_hal/startup_gcc/newlib_stubs.c ****  * #define MICROCHIP_STDIO_THRU_MMUARTX &g_mss_uart4_lo
  32:../src/platform/mpfs_hal/startup_gcc/newlib_stubs.c ****  * #define MICROCHIP_STDIO_THRU_MMUARTX &g_mss_uart0_hi
  33:../src/platform/mpfs_hal/startup_gcc/newlib_stubs.c ****  * #define MICROCHIP_STDIO_THRU_MMUARTX &g_mss_uart1_hi
  34:../src/platform/mpfs_hal/startup_gcc/newlib_stubs.c ****  * #define MICROCHIP_STDIO_THRU_MMUARTX &g_mss_uart2_hi
  35:../src/platform/mpfs_hal/startup_gcc/newlib_stubs.c ****  * #define MICROCHIP_STDIO_THRU_MMUARTX &g_mss_uart3_hi
  36:../src/platform/mpfs_hal/startup_gcc/newlib_stubs.c ****  * #define MICROCHIP_STDIO_THRU_MMUARTX &g_mss_uart4_hi
  37:../src/platform/mpfs_hal/startup_gcc/newlib_stubs.c ****  * The baud rate using the MICROCHIP_STDIO_BAUD_RATE define.
  38:../src/platform/mpfs_hal/startup_gcc/newlib_stubs.c ****  *
  39:../src/platform/mpfs_hal/startup_gcc/newlib_stubs.c ****  * Note: you must have mss_mmuart driver source code included in the project.
  40:../src/platform/mpfs_hal/startup_gcc/newlib_stubs.c ****  *
  41:../src/platform/mpfs_hal/startup_gcc/newlib_stubs.c ****  * Also note defaults to 115200 baud if no baud rate is specified using the
  42:../src/platform/mpfs_hal/startup_gcc/newlib_stubs.c ****  * MICROCHIP_STDIO_BAUD_RATE #define.
  43:../src/platform/mpfs_hal/startup_gcc/newlib_stubs.c ****  */
  44:../src/platform/mpfs_hal/startup_gcc/newlib_stubs.c **** #ifdef MICROCHIP_STDIO_THRU_MMUARTX
  45:../src/platform/mpfs_hal/startup_gcc/newlib_stubs.c **** #include "drivers/mss/mss_mmuart/mss_uart.h"
